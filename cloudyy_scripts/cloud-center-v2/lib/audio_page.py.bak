"""Cloud Center — Audio manager page backed by PipeWire/PulseAudio tools."""
from __future__ import annotations

import json
import logging
import shutil
import subprocess
import threading
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from gi.repository import Adw, GLib, Gtk

import lib.utility as utility

log = logging.getLogger(__name__)

# Config path for hidden devices
CONFIG_DIR = Path.home() / ".config" / "cloud-center"
HIDDEN_DEVICES_FILE = CONFIG_DIR / "hidden_audio_devices.json"


@dataclass
class Sink:
    index: int
    name: str
    description: str
    volume: int
    muted: bool
    is_default: bool
    active_port: str


@dataclass
class Source:
    index: int
    name: str
    description: str
    volume: int
    muted: bool
    is_default: bool
    active_port: str


@dataclass
class Stream:
    index: int
    app_name: str
    media_name: str
    sink_name: str
    volume: int
    muted: bool


@dataclass
class Card:
    index: int
    name: str
    driver: str
    active_profile: str
    profiles: list[str]


# Hidden device management
def _load_hidden_devices() -> set[str]:
    """Load set of hidden device names from config file."""
    if not HIDDEN_DEVICES_FILE.exists():
        return set()
    try:
        with open(HIDDEN_DEVICES_FILE) as f:
            data = json.load(f)
            return set(data.get("hidden", []))
    except Exception as e:
        log.warning("Failed to load hidden devices: %s", e)
        return set()


def _save_hidden_devices(hidden: set[str]) -> bool:
    """Save set of hidden device names to config file."""
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(HIDDEN_DEVICES_FILE, "w") as f:
            json.dump({"hidden": sorted(hidden)}, f, indent=2)
        return True
    except Exception as e:
        log.error("Failed to save hidden devices: %s", e)
        return False


def _toggle_hidden_device(device_name: str) -> None:
    """Toggle visibility of a device."""
    hidden = _load_hidden_devices()
    if device_name in hidden:
        hidden.remove(device_name)
        log.debug("Unhiding device: %s", device_name)
    else:
        hidden.add(device_name)
        log.debug("Hiding device: %s", device_name)
    _save_hidden_devices(hidden)


def _is_device_hidden(device_name: str) -> bool:
    """Check if a device is hidden."""
    return device_name in _load_hidden_devices()


def _run_cmd(args: list[str], timeout: int = 8, stderr_to_stdout: bool = False) -> tuple[bool, str]:
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        if stderr_to_stdout:
            output = (result.stdout or "") + (result.stderr or "")
        else:
            output = result.stdout or ""
        return result.returncode == 0, output
    except Exception as exc:
        return False, str(exc)


def _have_tool(name: str) -> bool:
    return shutil.which(name) is not None


def _pactl_json(section: str) -> list[dict[str, Any]]:
    ok, out = _run_cmd(["pactl", "-f", "json", "list", section], timeout=10)
    if not ok or not out.strip():
        log.warning("pactl -f json list %s failed or empty output", section)
        return []
    try:
        data = json.loads(out)
        # pactl -f json returns {"sinks": [...]} structure
        # Try section name first, then common variations
        candidates = [section]
        if section == "sinks":
            candidates.extend(["sinks", "sink"])
        elif section == "sources":
            candidates.extend(["sources", "source"])
        elif section == "sink-inputs":
            candidates.extend(["sink-inputs", "sink_inputs", "sinks-inputs"])
        elif section == "cards":
            candidates.extend(["cards", "card"])
        
        if isinstance(data, list):
            log.debug("Got direct list from pactl %s (#items: %d)", section, len(data))
            # If sinks, show Bluetooth device details
            if section == "sinks":
                for item in data:
                    if isinstance(item, dict):
                        name = item.get("name", "?")
                        if name.startswith("bluez_"):
                            log.debug("  BT sink: %s (driver: %s, state: %s)", name, item.get("driver"), item.get("state"))
            return data
        elif isinstance(data, dict):
            # Try each candidate key
            for key in candidates:
                if key in data:
                    val = data[key]
                    if isinstance(val, list):
                        log.debug("Found list at key '%s' in pactl %s (#items: %d)", key, section, len(val))
                        # If sinks, show Bluetooth device details
                        if section == "sinks":
                            for item in val:
                                if isinstance(item, dict):
                                    name = item.get("name", "?")
                                    if name.startswith("bluez_"):
                                        log.debug("  BT sink: %s (driver: %s, state: %s)", name, item.get("driver"), item.get("state"))
                        return val
            # Fallback: find first list in dict
            for k, v in data.items():
                if isinstance(v, list) and len(v) > 0:
                    log.debug("Fallback: found list at key '%s' in pactl %s output (#items: %d)", k, section, len(v))
                    return v
        
        log.warning("No list found in pactl %s output: %s", section, list(data.keys()) if isinstance(data, dict) else "not a dict")
    except json.JSONDecodeError as e:
        log.error("JSON decode error for pactl list %s: %s; first 200 chars: %s", section, e, out[:200])
    return []


def _get_default(kind: str) -> str:
    ok, out = _run_cmd(["pactl", f"get-default-{kind}"])
    if not ok:
        return ""
    return out.strip()


def _bluez_device_name(device_name: str) -> str:
    """Resolve friendly name for a bluez PipeWire device via bluetoothctl.

    bluez_output.70_8C_F2_67_D0_70.1  ->  MAC 70:8C:F2:67:D0:70
    Returns empty string on failure.
    """
    if not shutil.which("bluetoothctl"):
        return ""
    # Strip prefix and trailing profile index to isolate the MAC segment
    mac_part = device_name
    for prefix in ("bluez_output.", "bluez_input.", "bluez_source."):
        if mac_part.startswith(prefix):
            mac_part = mac_part[len(prefix):]
            break
    # Remove trailing .N (profile index)
    segments = mac_part.split(".")
    if len(segments) >= 2:
        mac_part = ".".join(segments[:-1])
    mac = mac_part.replace("_", ":")
    if len(mac) != 17:
        return ""
    ok, out = _run_cmd(["bluetoothctl", "info", mac], timeout=3)
    if not ok or not out:
        return ""
    for line in out.splitlines():
        stripped = line.strip()
        if stripped.startswith("Alias:"):
            return stripped[len("Alias:"):].strip()
        if stripped.startswith("Name:"):
            return stripped[len("Name:"):].strip()
    return ""


def _norm_vol(v: Any) -> int:
    """Extract volume as percentage from various pactl structures."""
    if isinstance(v, dict):
        # Check for nested dicts with "value_percent" fields
        all_percents: list[int] = []
        for k, x in v.items():
            if isinstance(x, dict):
                pct_str = x.get("value_percent", "")
                if isinstance(pct_str, str) and pct_str.endswith("%"):
                    try:
                        all_percents.append(int(float(pct_str[:-1])))
                    except (ValueError, IndexError):
                        pass
        if all_percents:
            avg = int(sum(all_percents) / len(all_percents))
            return max(0, min(150, avg))
    return 0


def list_sinks() -> list[Sink]:
    default_name = _get_default("sink")
    sinks: list[Sink] = []
    
    # Try JSON first
    entries = _pactl_json("sinks")
    if not entries:
        # Fallback to plaintext parsing
        log.debug("JSON parsing for sinks failed, trying plaintext fallback")
        entries = _parse_pactl_plaintext("sinks")
    
    log.info("Raw pactl output returned %d sink entries", len(entries))
    bluetooth_count = 0
    airpods_found = False
    
    for entry in entries:
        if not isinstance(entry, dict):
            log.debug("Skipping non-dict entry in sinks")
            continue
        name = str(entry.get("name", ""))
        if not name:
            log.debug("Sink entry has no name, skipping")
            continue
        
        raw_desc = str(entry.get("description", ""))
        null_desc = not raw_desc or raw_desc.lower() in ("(null)", "null")
        
        if null_desc:
            if name.startswith("bluez_"):
                # Resolve friendly name from BlueZ for Bluetooth devices
                resolved = _bluez_device_name(name)
                desc = resolved if resolved else "Bluetooth Audio Device"
                log.debug("Resolved BT sink %s -> %r", name, desc)
            else:
                log.debug("Skipping non-BT sink with null description: %s", name)
                continue
        else:
            desc = raw_desc
        
        # Track Bluetooth devices for debugging
        if name.startswith("bluez_"):
            bluetooth_count += 1
            log.debug("Found Bluetooth sink: %s (%s) [state: %s]", name, desc, entry.get("state", "?"))
            if "airpod" in desc.lower() or "airpod" in name.lower():
                airpods_found = True
                log.warning("*** AIRPODS DETECTED: %s ***", name)
        
        index = int(entry.get("index", -1))
        muted = bool(entry.get("mute", False))
        volume = _norm_vol(entry.get("volume", {}))
        active_port = str(entry.get("active_port", ""))
        sinks.append(Sink(
            index=index,
            name=name,
            description=desc,
            volume=volume,
            muted=muted,
            is_default=name == default_name,
            active_port=active_port,
        ))
    
    sinks.sort(key=lambda s: (not s.is_default, s.description.lower()))
    log.info("Discovered %d sinks (including %d Bluetooth%s)", len(sinks), bluetooth_count, 
             "; AirPods detected" if airpods_found else "")
    return sinks


def _parse_pactl_plaintext(section: str) -> list[dict[str, Any]]:
    """Fallback plaintext parser for pactl output."""
    ok, out = _run_cmd(["pactl", "list", section])
    if not ok or not out:
        return []
    
    entries: list[dict[str, Any]] = []
    current: dict[str, Any] = {}
    
    for line in out.splitlines():
        line = line.rstrip()
        if line.startswith("#"):
            continue
        
        # Section header like "Sink #0" or "Card #0"
        if line.startswith(section.rstrip("s").capitalize() + " #"):
            if current:
                entries.append(current)
            current = {}
            try:
                idx = int(line.split("#")[1].split()[0])
                current["index"] = idx
            except (ValueError, IndexError):
                pass
        elif "\t" in line and ":" in line:
            key, _, value = line.split(":", 1)
            key = key.strip().lower().replace(" ", "_")
            value = value.strip()
            current[key] = value
    
    if current:
        entries.append(current)
    
    return entries


def list_sources() -> list[Source]:
    default_name = _get_default("source")
    sources: list[Source] = []
    
    # Try JSON first
    entries = _pactl_json("sources")
    if not entries:
        log.debug("JSON parsing for sources failed, trying plaintext fallback")
        entries = _parse_pactl_plaintext("sources")
    
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("name", ""))
        if not name or name.endswith(".monitor"):
            continue
        
        raw_desc = str(entry.get("description", ""))
        null_desc = not raw_desc or raw_desc.lower() in ("(null)", "null")
        
        if null_desc:
            if name.startswith(("bluez_", "bluez_source")):
                resolved = _bluez_device_name(name)
                desc = resolved if resolved else "Bluetooth Audio Device"
                log.debug("Resolved BT source %s -> %r", name, desc)
            else:
                log.debug("Skipping non-BT source with null description: %s", name)
                continue
        else:
            desc = raw_desc
        index = int(entry.get("index", -1))
        muted = bool(entry.get("mute", False))
        volume = _norm_vol(entry.get("volume", {}))
        active_port = str(entry.get("active_port", ""))
        sources.append(Source(
            index=index,
            name=name,
            description=desc,
            volume=volume,
            muted=muted,
            is_default=name == default_name,
            active_port=active_port,
        ))
    sources.sort(key=lambda s: (not s.is_default, s.description.lower()))
    log.info("Discovered %d sources", len(sources))
    return sources


def list_streams() -> list[Stream]:
    streams: list[Stream] = []
    for entry in _pactl_json("sink-inputs"):
        props = entry.get("properties", {}) if isinstance(entry.get("properties", {}), dict) else {}
        app_name = str(props.get("application.name", "Unknown App"))
        media_name = str(props.get("media.name", "Playback Stream"))
        index = int(entry.get("index", -1))
        sink_name = str(entry.get("sink", ""))
        muted = bool(entry.get("mute", False))
        volume = _norm_vol(entry.get("volume", {}))
        streams.append(Stream(
            index=index,
            app_name=app_name,
            media_name=media_name,
            sink_name=sink_name,
            volume=volume,
            muted=muted,
        ))
    streams.sort(key=lambda s: (s.app_name.lower(), s.media_name.lower()))
    log.info("Discovered %d streams", len(streams))
    return streams


def list_cards() -> list[Card]:
    cards: list[Card] = []
    
    # Try JSON first
    entries = _pactl_json("cards")
    if not entries:
        log.debug("JSON parsing for cards failed, trying plaintext fallback")
        entries = _parse_pactl_plaintext("cards")
    
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("name", ""))
        if not name:
            continue
        index = int(entry.get("index", -1))
        driver = str(entry.get("driver", ""))
        active_profile = str(entry.get("active_profile", ""))
        profiles_obj = entry.get("profiles", [])
        profiles: list[str] = []
        if isinstance(profiles_obj, list):
            for p in profiles_obj:
                if isinstance(p, dict):
                    profiles.append(str(p.get("name", "")))
        cards.append(Card(
            index=index,
            name=name,
            driver=driver,
            active_profile=active_profile,
            profiles=[p for p in profiles if p],
        ))
    cards.sort(key=lambda c: c.name.lower())
    log.info("Discovered %d cards", len(cards))
    return cards


def set_sink_volume(name: str, value: int) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-sink-volume", name, f"{value}%"])


def set_source_volume(name: str, value: int) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-source-volume", name, f"{value}%"])


def set_stream_volume(stream_id: int, value: int) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-sink-input-volume", str(stream_id), f"{value}%"])


def set_sink_mute(name: str, mute: bool) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-sink-mute", name, "1" if mute else "0"])


def set_source_mute(name: str, mute: bool) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-source-mute", name, "1" if mute else "0"])


def set_stream_mute(stream_id: int, mute: bool) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-sink-input-mute", str(stream_id), "1" if mute else "0"])


def set_default_sink(name: str) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-default-sink", name])


def set_default_source(name: str) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-default-source", name])


def move_stream(stream_id: int, sink_name: str) -> tuple[bool, str]:
    return _run_cmd(["pactl", "move-sink-input", str(stream_id), sink_name])


def set_card_profile(card_name: str, profile_name: str) -> tuple[bool, str]:
    return _run_cmd(["pactl", "set-card-profile", card_name, profile_name])


class AudioPage(Gtk.Box):
    """Two-panel Audio manager page."""

    def __init__(self, toast_overlay: Adw.ToastOverlay) -> None:
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self._toast_ov = toast_overlay
        self._sinks: list[Sink] = []
        self._sources: list[Source] = []
        self._streams: list[Stream] = []
        self._cards: list[Card] = []

        self._selected_kind: str | None = None
        self._selected_id: str | None = None
        self._loading = False
        self._separator: Gtk.Separator | None = None
        self._right_panel_sep: Gtk.Separator | None = None

        self._list = Gtk.ListBox()
        self._right_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._status = Gtk.Label(label="")

        self._build_ui()
        self.refresh()

    def _build_ui(self) -> None:
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        toolbar.set_margin_start(16)
        toolbar.set_margin_end(12)
        toolbar.set_margin_top(10)
        toolbar.set_margin_bottom(6)

        title = Gtk.Label(label="Audio")
        title.add_css_class("heading")
        title.set_xalign(0)
        title.set_hexpand(True)

        self._status.add_css_class("dim-label")
        self._status.add_css_class("caption")

        refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh_btn.add_css_class("flat")
        refresh_btn.set_tooltip_text("Refresh audio state")
        refresh_btn.connect("clicked", lambda _: self.refresh())

        toolbar.append(title)
        toolbar.append(self._status)
        toolbar.append(refresh_btn)

        self.append(toolbar)
        self.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        pane = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        pane.set_vexpand(True)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        left.set_size_request(360, -1)

        self._list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._list.add_css_class("navigation-sidebar")
        self._list.connect("row-selected", self._on_row_selected)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        scroll.set_child(self._list)
        left.append(scroll)

        self._right_panel.set_hexpand(True)
        # Don't show placeholder yet; show it only when device is selected

        pane.append(left)
        self._right_panel_sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        pane.append(self._right_panel_sep)
        pane.append(self._right_panel)
        self.append(pane)

    def _show_placeholder(self) -> None:
        self._clear_right()
        status = Adw.StatusPage(
            icon_name="audio-speakers-symbolic",
            title="No Audio Item Selected",
            description="Pick an output, input, stream, or card from the left panel.",
        )
        status.set_vexpand(True)
        self._right_panel.append(status)

    def _clear_right(self) -> None:
        child = self._right_panel.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._right_panel.remove(child)
            child = nxt

    def refresh(self) -> None:
        if self._loading:
            return
        self._loading = True

        if not _have_tool("pactl"):
            self._status.set_text("pactl not found")
            self._show_backend_missing()
            self._loading = False
            return

        self._status.set_text("Loading audio state…")
        log.debug("Starting audio refresh")

        def worker() -> None:
            try:
                sinks = list_sinks()
                sources = list_sources()
                streams = list_streams()
                cards = list_cards()
                log.debug(
                    "Audio backend query: %d sinks, %d sources, %d streams, %d cards",
                    len(sinks), len(sources), len(streams), len(cards)
                )
                GLib.idle_add(self._apply_refresh, sinks, sources, streams, cards)
            except Exception as e:
                log.error("Audio refresh worker failed: %s", e)
                GLib.idle_add(self._apply_refresh, [], [], [], [])

        threading.Thread(target=worker, daemon=True).start()

    def _show_backend_missing(self) -> None:
        self._clear_right()
        status = Adw.StatusPage(
            icon_name="dialog-error-symbolic",
            title="Audio Backend Not Available",
            description="Install PipeWire/PulseAudio user tools (pactl/wpctl) and retry.",
        )
        status.set_vexpand(True)
        self._right_panel.append(status)

    def _apply_refresh(
        self,
        sinks: list[Sink],
        sources: list[Source],
        streams: list[Stream],
        cards: list[Card],
    ) -> bool:
        self._loading = False
        self._sinks = sinks
        self._sources = sources
        self._streams = streams
        self._cards = cards

        self._rebuild_list()
        self._status.set_text(
            f"{len(sinks)} outputs • {len(sources)} inputs • {len(streams)} streams • {len(cards)} cards"
        )
        return GLib.SOURCE_REMOVE

    def _append_section_header(self, title: str) -> None:
        row = Gtk.ListBoxRow()
        row.set_selectable(False)
        row.set_activatable(False)
        row.add_css_class("sidebar-category-row")

        lbl = Gtk.Label(label=title)
        lbl.set_xalign(0)
        lbl.add_css_class("sidebar-category-label")
        lbl.set_margin_start(12)
        lbl.set_margin_end(12)
        lbl.set_margin_top(10)
        lbl.set_margin_bottom(4)
        row.set_child(lbl)
        self._list.append(row)

    def _append_item_row(self, kind: str, item_id: str, title: str, subtitle: str = "", is_hidden: bool = False) -> None:
        row = Gtk.ListBoxRow()
        row._audio_kind = kind  # type: ignore[attr-defined]
        row._audio_id = item_id  # type: ignore[attr-defined]
        row.add_css_class("sidebar-nav-row")

        # Use ActionRow for better styling and suffix support
        action_row = Adw.ActionRow(title=title, subtitle=subtitle)
        action_row.set_activatable(False)
        
        # Add eye icon toggle button
        eye_btn = Gtk.Button()
        eye_btn.set_icon_name("eye-closed-negative-filled-symbolic" if is_hidden else "eye-open-negative-filled-symbolic")
        eye_btn.add_css_class("flat")
        eye_btn.set_tooltip_text("Unhide" if is_hidden else "Hide")
        
        def on_eye_click(btn: Gtk.Button) -> None:
            _toggle_hidden_device(item_id)
            # Refresh the list
            self.refresh()
        
        eye_btn.connect("clicked", on_eye_click)
        action_row.add_suffix(eye_btn)
        
        row.set_child(action_row)
        self._list.append(row)

    def _rebuild_list(self) -> None:
        child = self._list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self._list.remove(child)
            child = nxt

        hidden_devices = _load_hidden_devices()
        has_any = bool(self._sinks or self._sources or self._streams or self._cards)

        # Separate devices into visible and hidden
        visible_sinks = [s for s in self._sinks if s.name not in hidden_devices]
        hidden_sinks = [s for s in self._sinks if s.name in hidden_devices]
        visible_sources = [s for s in self._sources if s.name not in hidden_devices]
        hidden_sources = [s for s in self._sources if s.name in hidden_devices]

        # Display visible devices
        self._append_section_header("Outputs")
        if visible_sinks:
            for sink in visible_sinks:
                label = sink.description
                if sink.is_default:
                    label = f"{label} (Default)"
                self._append_item_row("sink", sink.name, label, f"{sink.volume}%", is_hidden=False)
        else:
            self._append_placeholder_row("No outputs found")

        self._append_section_header("Inputs")
        if visible_sources:
            for source in visible_sources:
                label = source.description
                if source.is_default:
                    label = f"{label} (Default)"
                self._append_item_row("source", source.name, label, f"{source.volume}%", is_hidden=False)
        else:
            self._append_placeholder_row("No inputs found")

        self._append_section_header("Applications")
        if self._streams:
            for stream in self._streams:
                self._append_item_row(
                    "stream",
                    str(stream.index),
                    stream.app_name,
                    f"{stream.media_name} • {stream.volume}%",
                    is_hidden=False,
                )
        else:
            self._append_placeholder_row("No active streams")

        self._append_section_header("Cards")
        if self._cards:
            for card in self._cards:
                profile = card.active_profile if card.active_profile else "none"
                self._append_item_row("card", card.name, card.name, f"Profile: {profile}", is_hidden=False)
        else:
            self._append_placeholder_row("No audio cards found")

        # Display hidden devices in a separate section
        if hidden_sinks or hidden_sources:
            self._append_section_header("Hidden")
            for sink in hidden_sinks:
                label = sink.description
                if sink.is_default:
                    label = f"{label} (Default)"
                self._append_item_row("sink", sink.name, label, f"{sink.volume}%", is_hidden=True)
            
            for source in hidden_sources:
                label = source.description
                if source.is_default:
                    label = f"{label} (Default)"
                self._append_item_row("source", source.name, label, f"{source.volume}%", is_hidden=True)

        if not has_any:
            return
        self._show_placeholder()

    def _append_placeholder_row(self, text: str) -> None:
        row = Gtk.ListBoxRow()
        row.set_selectable(False)
        row.set_activatable(False)
        lbl = Gtk.Label(label=text)
        lbl.set_xalign(0)
        lbl.add_css_class("dim-label")
        lbl.add_css_class("caption")
        lbl.set_margin_start(12)
        lbl.set_margin_end(12)
        lbl.set_margin_top(4)
        lbl.set_margin_bottom(4)
        row.set_child(lbl)
        self._list.append(row)

    def _find_row(self, kind: str, item_id: str) -> Gtk.ListBoxRow | None:
        child = self._list.get_first_child()
        while child:
            if isinstance(child, Gtk.ListBoxRow):
                k = getattr(child, "_audio_kind", None)
                i = getattr(child, "_audio_id", None)
                if k == kind and i == item_id:
                    return child
            child = child.get_next_sibling()
        return None

    def _on_row_selected(self, _list: Gtk.ListBox, row: Gtk.ListBoxRow | None) -> None:
        if row is None:
            # Hide right panel when nothing selected
            self._hide_right_panel()
            return
        
        kind = getattr(row, "_audio_kind", None)
        item_id = getattr(row, "_audio_id", None)
        
        if not kind or not item_id:
            # Hide right panel when non-device row is selected (e.g., section headers)
            self._hide_right_panel()
            return
        
        # Show right panel for device rows
        self._show_right_panel()
        self._selected_kind = kind
        self._selected_id = item_id

        if kind == "sink":
            sink = next((s for s in self._sinks if s.name == item_id), None)
            if sink:
                self._show_sink_detail(sink)
        elif kind == "source":
            source = next((s for s in self._sources if s.name == item_id), None)
            if source:
                self._show_source_detail(source)
        elif kind == "stream":
            stream = next((s for s in self._streams if str(s.index) == item_id), None)
            if stream:
                self._show_stream_detail(stream)
        elif kind == "card":
            card = next((c for c in self._cards if c.name == item_id), None)
            if card:
                self._show_card_detail(card)
    
    def _show_right_panel(self) -> None:
        """Show the right panel and vertical separator."""
        self._right_panel.set_visible(True)
        if self._right_panel_sep:
            self._right_panel_sep.set_visible(True)
    
    def _hide_right_panel(self) -> None:
        """Hide the right panel and vertical separator."""
        self._right_panel.set_visible(False)
        if self._right_panel_sep:
            self._right_panel_sep.set_visible(False)

    def _build_detail_shell(self, title: str, subtitle: str) -> Gtk.Box:
        self._clear_right()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_start(20)
        box.set_margin_end(20)
        box.set_margin_top(20)
        box.set_margin_bottom(20)

        title_lbl = Gtk.Label(label=title)
        title_lbl.add_css_class("title-2")
        title_lbl.set_xalign(0)
        title_lbl.set_wrap(True)

        sub_lbl = Gtk.Label(label=subtitle)
        sub_lbl.set_xalign(0)
        sub_lbl.set_wrap(True)
        sub_lbl.add_css_class("dim-label")

        box.append(title_lbl)
        box.append(sub_lbl)
        self._right_panel.append(box)
        return box

    def _action_result(self, ok: bool, _details: str, success: str, fail: str) -> None:
        if ok:
            utility.toast(self._toast_ov, success)
        else:
            if _details.strip():
                log.warning("Audio action failed: %s", _details.strip())
            utility.toast(self._toast_ov, fail)
        self.refresh()

    def _show_sink_detail(self, sink: Sink) -> None:
        box = self._build_detail_shell(sink.description, sink.name)

        vol_row = Adw.ActionRow(title="Volume")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        scale.set_hexpand(True)
        scale.set_value(sink.volume)
        value_lbl = Gtk.Label(label=f"{sink.volume}%")
        scale.connect("value-changed", lambda s: value_lbl.set_text(f"{int(s.get_value())}%"))
        apply_btn = Gtk.Button(label="Apply")
        apply_btn.connect(
            "clicked",
            lambda _: self._action_result(
                *set_sink_volume(sink.name, int(scale.get_value())),
                success="Output volume updated",
                fail="Failed to update output volume",
            ),
        )
        vol_row.add_suffix(value_lbl)
        vol_row.add_suffix(apply_btn)
        vol_row.add_suffix(scale)
        vol_row.set_activatable(False)

        mute_row = Adw.SwitchRow(title="Mute")
        mute_row.set_active(sink.muted)
        mute_row.connect(
            "notify::active",
            lambda sw, _p: self._action_result(
                *set_sink_mute(sink.name, sw.get_active()),
                success="Output mute updated",
                fail="Failed to update output mute",
            ),
        )

        default_row = Adw.ActionRow(title="Default Output")
        def_btn = Gtk.Button(label="Set Default")
        def_btn.set_sensitive(not sink.is_default)
        def_btn.connect(
            "clicked",
            lambda _: self._action_result(
                *set_default_sink(sink.name),
                success="Default output changed",
                fail="Failed to set default output",
            ),
        )
        default_row.add_suffix(def_btn)

        grp = Adw.PreferencesGroup()
        grp.add(vol_row)
        grp.add(mute_row)
        grp.add(default_row)
        box.append(grp)

    def _show_source_detail(self, source: Source) -> None:
        box = self._build_detail_shell(source.description, source.name)

        vol_row = Adw.ActionRow(title="Volume")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        scale.set_hexpand(True)
        scale.set_value(source.volume)
        value_lbl = Gtk.Label(label=f"{source.volume}%")
        scale.connect("value-changed", lambda s: value_lbl.set_text(f"{int(s.get_value())}%"))
        apply_btn = Gtk.Button(label="Apply")
        apply_btn.connect(
            "clicked",
            lambda _: self._action_result(
                *set_source_volume(source.name, int(scale.get_value())),
                success="Input volume updated",
                fail="Failed to update input volume",
            ),
        )
        vol_row.add_suffix(value_lbl)
        vol_row.add_suffix(apply_btn)
        vol_row.add_suffix(scale)
        vol_row.set_activatable(False)

        mute_row = Adw.SwitchRow(title="Mute")
        mute_row.set_active(source.muted)
        mute_row.connect(
            "notify::active",
            lambda sw, _p: self._action_result(
                *set_source_mute(source.name, sw.get_active()),
                success="Input mute updated",
                fail="Failed to update input mute",
            ),
        )

        default_row = Adw.ActionRow(title="Default Input")
        def_btn = Gtk.Button(label="Set Default")
        def_btn.set_sensitive(not source.is_default)
        def_btn.connect(
            "clicked",
            lambda _: self._action_result(
                *set_default_source(source.name),
                success="Default input changed",
                fail="Failed to set default input",
            ),
        )
        default_row.add_suffix(def_btn)

        grp = Adw.PreferencesGroup()
        grp.add(vol_row)
        grp.add(mute_row)
        grp.add(default_row)
        box.append(grp)

    def _show_stream_detail(self, stream: Stream) -> None:
        box = self._build_detail_shell(stream.app_name, stream.media_name)

        vol_row = Adw.ActionRow(title="Stream Volume")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 150, 1)
        scale.set_hexpand(True)
        scale.set_value(stream.volume)
        value_lbl = Gtk.Label(label=f"{stream.volume}%")
        scale.connect("value-changed", lambda s: value_lbl.set_text(f"{int(s.get_value())}%"))
        apply_btn = Gtk.Button(label="Apply")
        apply_btn.connect(
            "clicked",
            lambda _: self._action_result(
                *set_stream_volume(stream.index, int(scale.get_value())),
                success="Stream volume updated",
                fail="Failed to update stream volume",
            ),
        )
        vol_row.add_suffix(value_lbl)
        vol_row.add_suffix(apply_btn)
        vol_row.add_suffix(scale)
        vol_row.set_activatable(False)

        mute_row = Adw.SwitchRow(title="Mute Stream")
        mute_row.set_active(stream.muted)
        mute_row.connect(
            "notify::active",
            lambda sw, _p: self._action_result(
                *set_stream_mute(stream.index, sw.get_active()),
                success="Stream mute updated",
                fail="Failed to update stream mute",
            ),
        )

        move_row = Adw.ComboRow(title="Move Stream To Output")
        sink_names = [s.name for s in self._sinks]
        sink_labels = [s.description for s in self._sinks]
        model = Gtk.StringList.new(sink_labels)
        move_row.set_model(model)
        active_idx = 0
        for idx, s in enumerate(self._sinks):
            if s.name == stream.sink_name:
                active_idx = idx
                break
        move_row.set_selected(active_idx)

        apply_move = Gtk.Button(label="Move")

        def on_move(_: Gtk.Button) -> None:
            idx = int(move_row.get_selected())
            if idx < 0 or idx >= len(sink_names):
                return
            self._action_result(
                *move_stream(stream.index, sink_names[idx]),
                success="Stream moved",
                fail="Failed to move stream",
            )

        apply_move.connect("clicked", on_move)
        move_row.add_suffix(apply_move)

        grp = Adw.PreferencesGroup()
        grp.add(vol_row)
        grp.add(mute_row)
        grp.add(move_row)
        box.append(grp)

    def _show_card_detail(self, card: Card) -> None:
        box = self._build_detail_shell(card.name, card.driver or "Card")

        profile_row = Adw.ComboRow(title="Profile")
        profiles = card.profiles or ([card.active_profile] if card.active_profile else [])
        model = Gtk.StringList.new(profiles)
        profile_row.set_model(model)
        idx = 0
        if card.active_profile in profiles:
            idx = profiles.index(card.active_profile)
        profile_row.set_selected(idx)

        apply_btn = Gtk.Button(label="Apply")

        def on_apply(_: Gtk.Button) -> None:
            sel = int(profile_row.get_selected())
            if sel < 0 or sel >= len(profiles):
                return
            self._action_result(
                *set_card_profile(card.name, profiles[sel]),
                success="Card profile updated",
                fail="Failed to update card profile",
            )

        apply_btn.connect("clicked", on_apply)
        profile_row.add_suffix(apply_btn)

        grp = Adw.PreferencesGroup()
        grp.add(profile_row)
        box.append(grp)
