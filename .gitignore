cloudyy_scripts/launch-matlab.sh
cloudyy_scripts/pin-ksp.sh
cloudyy_scripts/trcc-headless.py


# hyprland theme state

.config/hypr/theme_state/*
!.config/hypr/theme_state/apply_theme.sh
.config/matugen/generated/

# External Rust crates — source in ~/Projects/, binaries from AUR
.config/quickshell/cloudyy-system-monitor/
cloudyy_scripts/source/hcm/

