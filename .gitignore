# Editor temp files
*.swap

# User machine-specific dotfiles — generated by install scripts, not tracked
.gitconfig
.bash_profile
.zshenv
.config/zsh/.zprofile
.config/zsh/.p10k.zsh
.config/zsh/.bashrc
.config/zsh/.bash_logout
.config/zsh/.yarnrc
.config/zsh/personal_alias.md

# Hyprland local user overrides
.config/hypr/welcome_message.txt

# Shell runtime state
.config/zsh/oh-my-zsh
.config/zsh/.zsh_history
.config/zsh/.zcompdump*
.config/zsh/.bash_history

# Browser profile data
.config/mozilla/
.config/spicetify/Themes/ComfyRepo/


# VS Code OSS local extensions/cache
.vscode-oss/
.vscode-oss/extensions/*
!.vscode-oss/extensions/matugen-theme
cloudyy_scripts/cloud-center-v2/vscode-gtk-icons/

# Private user wallpapers — never commit images
Wallpapers/user_wallpapers/**/*
!Wallpapers/user_wallpapers/**/
!Wallpapers/user_wallpapers/**/.gitkeep

# Local scripts and private data
cloudyy_scripts/cloudyy-other/folio-gtk
cloudyy_scripts/cloudyy-other/keypunch
