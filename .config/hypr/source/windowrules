#===============================================================#

#--------------------------------------------------------------#

# Application specific rules

# Brave browser #
windowrule {
    name        = brave-browser
    match:class = ^(brave-browser)$
    size        = 1080 1080
    float       = on
  }

# image-viewer (loupe) #
windowrule {
    name        = image-viewer
    match:class = ^(org.gnome.Loupe)$
    size        = 900 900
    float       = on

  }
