# Matugen btop template
# Theme: #d8bafb

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#151218"

# Main text color
theme[main_fg]="#e7e0e8"

# Title color for boxes
theme[title]="#d8bafb"

# Highlight color for listview items
theme[hi_fg]="#3c245a"

# Background color of selected item in processes box
theme[selected_bg]="#d8bafb"

# Foreground color of selected item in processes box
theme[selected_fg]="#3c245a"

# Color of inactive/disabled text
theme[inactive_fg]="#958e99"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ccc4cf"

# Background color of the percentage meters
theme[meter_bg]="#373339"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#cfc1da"

# Cpu box outline color
theme[cpu_box]="#4a454e"

# Memory box outline color
theme[mem_box]="#4a454e"

# Net box outline color
theme[net_box]="#4a454e"

# Processes box outline color
theme[proc_box]="#4a454e"

# Box divider line and small boxes line color
theme[div_line]="#4a454e"

# Temperature graph colors
theme[temp_start]="#d8bafb"
theme[temp_mid]="#cfc1da"
theme[temp_end]="#f2b7c1"

# CPU graph colors
theme[cpu_start]="#d8bafb"
theme[cpu_mid]="#cfc1da"
theme[cpu_end]="#f2b7c1"

# Mem/Disk free meter
theme[free_start]="#cfc1da"
theme[free_mid]="#cfc1da"
theme[free_end]="#f2b7c1"

# Mem/Disk cached meter
theme[cached_start]="#cfc1da"
theme[cached_mid]="#cfc1da"
theme[cached_end]="#f2b7c1"

# Mem/Disk available meter
theme[available_start]="#f2b7c1"
theme[available_mid]="#f2b7c1"
theme[available_end]="#d8bafb"

# Mem/Disk used meter
theme[used_start]="#d8bafb"
theme[used_mid]="#d8bafb"
theme[used_end]="#cfc1da"

# Download graph colors
theme[download_start]="#d8bafb"
theme[download_mid]="#cfc1da"
theme[download_end]="#f2b7c1"

# Upload graph colors
theme[upload_start]="#f2b7c1"
theme[upload_mid]="#cfc1da"
theme[upload_end]="#d8bafb"
