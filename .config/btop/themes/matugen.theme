# Matugen btop template
# Theme: #afc6ff

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#121318"

# Main text color
theme[main_fg]="#e2e2e9"

# Title color for boxes
theme[title]="#afc6ff"

# Highlight color for listview items
theme[hi_fg]="#142f60"

# Background color of selected item in processes box
theme[selected_bg]="#afc6ff"

# Foreground color of selected item in processes box
theme[selected_fg]="#142f60"

# Color of inactive/disabled text
theme[inactive_fg]="#8f9099"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c5c6d0"

# Background color of the percentage meters
theme[meter_bg]="#33353a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bfc6dc"

# Cpu box outline color
theme[cpu_box]="#44464f"

# Memory box outline color
theme[mem_box]="#44464f"

# Net box outline color
theme[net_box]="#44464f"

# Processes box outline color
theme[proc_box]="#44464f"

# Box divider line and small boxes line color
theme[div_line]="#44464f"

# Temperature graph colors
theme[temp_start]="#afc6ff"
theme[temp_mid]="#bfc6dc"
theme[temp_end]="#dfbbde"

# CPU graph colors
theme[cpu_start]="#afc6ff"
theme[cpu_mid]="#bfc6dc"
theme[cpu_end]="#dfbbde"

# Mem/Disk free meter
theme[free_start]="#bfc6dc"
theme[free_mid]="#bfc6dc"
theme[free_end]="#dfbbde"

# Mem/Disk cached meter
theme[cached_start]="#bfc6dc"
theme[cached_mid]="#bfc6dc"
theme[cached_end]="#dfbbde"

# Mem/Disk available meter
theme[available_start]="#dfbbde"
theme[available_mid]="#dfbbde"
theme[available_end]="#afc6ff"

# Mem/Disk used meter
theme[used_start]="#afc6ff"
theme[used_mid]="#afc6ff"
theme[used_end]="#bfc6dc"

# Download graph colors
theme[download_start]="#afc6ff"
theme[download_mid]="#bfc6dc"
theme[download_end]="#dfbbde"

# Upload graph colors
theme[upload_start]="#dfbbde"
theme[upload_mid]="#bfc6dc"
theme[upload_end]="#afc6ff"
