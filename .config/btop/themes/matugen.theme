# Matugen btop template
# Theme: #d7c950

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#131313"

# Main text color
theme[main_fg]="#e2e2e2"

# Title color for boxes
theme[title]="#d7c950"

# Highlight color for listview items
theme[hi_fg]="#363100"

# Background color of selected item in processes box
theme[selected_bg]="#d7c950"

# Foreground color of selected item in processes box
theme[selected_fg]="#363100"

# Color of inactive/disabled text
theme[inactive_fg]="#919191"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c6c6c6"

# Background color of the percentage meters
theme[meter_bg]="#353535"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#cec7a3"

# Cpu box outline color
theme[cpu_box]="#474747"

# Memory box outline color
theme[mem_box]="#474747"

# Net box outline color
theme[net_box]="#474747"

# Processes box outline color
theme[proc_box]="#474747"

# Box divider line and small boxes line color
theme[div_line]="#474747"

# Temperature graph colors
theme[temp_start]="#d7c950"
theme[temp_mid]="#cec7a3"
theme[temp_end]="#a6d0b8"

# CPU graph colors
theme[cpu_start]="#d7c950"
theme[cpu_mid]="#cec7a3"
theme[cpu_end]="#a6d0b8"

# Mem/Disk free meter
theme[free_start]="#cec7a3"
theme[free_mid]="#cec7a3"
theme[free_end]="#a6d0b8"

# Mem/Disk cached meter
theme[cached_start]="#cec7a3"
theme[cached_mid]="#cec7a3"
theme[cached_end]="#a6d0b8"

# Mem/Disk available meter
theme[available_start]="#a6d0b8"
theme[available_mid]="#a6d0b8"
theme[available_end]="#d7c950"

# Mem/Disk used meter
theme[used_start]="#d7c950"
theme[used_mid]="#d7c950"
theme[used_end]="#cec7a3"

# Download graph colors
theme[download_start]="#d7c950"
theme[download_mid]="#cec7a3"
theme[download_end]="#a6d0b8"

# Upload graph colors
theme[upload_start]="#a6d0b8"
theme[upload_mid]="#cec7a3"
theme[upload_end]="#d7c950"
