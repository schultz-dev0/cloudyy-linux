# Matugen btop template
# Theme: #98ccf9

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101418"

# Main text color
theme[main_fg]="#e0e2e8"

# Title color for boxes
theme[title]="#98ccf9"

# Highlight color for listview items
theme[hi_fg]="#003351"

# Background color of selected item in processes box
theme[selected_bg]="#98ccf9"

# Foreground color of selected item in processes box
theme[selected_fg]="#003351"

# Color of inactive/disabled text
theme[inactive_fg]="#8c9198"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c2c7ce"

# Background color of the percentage meters
theme[meter_bg]="#313539"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#b8c8da"

# Cpu box outline color
theme[cpu_box]="#42474e"

# Memory box outline color
theme[mem_box]="#42474e"

# Net box outline color
theme[net_box]="#42474e"

# Processes box outline color
theme[proc_box]="#42474e"

# Box divider line and small boxes line color
theme[div_line]="#42474e"

# Temperature graph colors
theme[temp_start]="#98ccf9"
theme[temp_mid]="#b8c8da"
theme[temp_end]="#d1bfe7"

# CPU graph colors
theme[cpu_start]="#98ccf9"
theme[cpu_mid]="#b8c8da"
theme[cpu_end]="#d1bfe7"

# Mem/Disk free meter
theme[free_start]="#b8c8da"
theme[free_mid]="#b8c8da"
theme[free_end]="#d1bfe7"

# Mem/Disk cached meter
theme[cached_start]="#b8c8da"
theme[cached_mid]="#b8c8da"
theme[cached_end]="#d1bfe7"

# Mem/Disk available meter
theme[available_start]="#d1bfe7"
theme[available_mid]="#d1bfe7"
theme[available_end]="#98ccf9"

# Mem/Disk used meter
theme[used_start]="#98ccf9"
theme[used_mid]="#98ccf9"
theme[used_end]="#b8c8da"

# Download graph colors
theme[download_start]="#98ccf9"
theme[download_mid]="#b8c8da"
theme[download_end]="#d1bfe7"

# Upload graph colors
theme[upload_start]="#d1bfe7"
theme[upload_mid]="#b8c8da"
theme[upload_end]="#98ccf9"
