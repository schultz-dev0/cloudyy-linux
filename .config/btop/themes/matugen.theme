# Matugen btop template
# Theme: #fdb975

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#19120c"

# Main text color
theme[main_fg]="#efe0d5"

# Title color for boxes
theme[title]="#fdb975"

# Highlight color for listview items
theme[hi_fg]="#4a2800"

# Background color of selected item in processes box
theme[selected_bg]="#fdb975"

# Foreground color of selected item in processes box
theme[selected_fg]="#4a2800"

# Color of inactive/disabled text
theme[inactive_fg]="#9d8e81"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d5c3b5"

# Background color of the percentage meters
theme[meter_bg]="#3c332c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e1c1a4"

# Cpu box outline color
theme[cpu_box]="#51453a"

# Memory box outline color
theme[mem_box]="#51453a"

# Net box outline color
theme[net_box]="#51453a"

# Processes box outline color
theme[proc_box]="#51453a"

# Box divider line and small boxes line color
theme[div_line]="#51453a"

# Temperature graph colors
theme[temp_start]="#fdb975"
theme[temp_mid]="#e1c1a4"
theme[temp_end]="#c0cc9a"

# CPU graph colors
theme[cpu_start]="#fdb975"
theme[cpu_mid]="#e1c1a4"
theme[cpu_end]="#c0cc9a"

# Mem/Disk free meter
theme[free_start]="#e1c1a4"
theme[free_mid]="#e1c1a4"
theme[free_end]="#c0cc9a"

# Mem/Disk cached meter
theme[cached_start]="#e1c1a4"
theme[cached_mid]="#e1c1a4"
theme[cached_end]="#c0cc9a"

# Mem/Disk available meter
theme[available_start]="#c0cc9a"
theme[available_mid]="#c0cc9a"
theme[available_end]="#fdb975"

# Mem/Disk used meter
theme[used_start]="#fdb975"
theme[used_mid]="#fdb975"
theme[used_end]="#e1c1a4"

# Download graph colors
theme[download_start]="#fdb975"
theme[download_mid]="#e1c1a4"
theme[download_end]="#c0cc9a"

# Upload graph colors
theme[upload_start]="#c0cc9a"
theme[upload_mid]="#e1c1a4"
theme[upload_end]="#fdb975"
