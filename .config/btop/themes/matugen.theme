# Matugen btop template
# Theme: #ffffff

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#131313"

# Main text color
theme[main_fg]="#e2e2e2"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for listview items
theme[hi_fg]="#1b1b1b"

# Background color of selected item in processes box
theme[selected_bg]="#ffffff"

# Foreground color of selected item in processes box
theme[selected_fg]="#1b1b1b"

# Color of inactive/disabled text
theme[inactive_fg]="#919191"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c6c6c6"

# Background color of the percentage meters
theme[meter_bg]="#353535"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c6c6c6"

# Cpu box outline color
theme[cpu_box]="#474747"

# Memory box outline color
theme[mem_box]="#474747"

# Net box outline color
theme[net_box]="#474747"

# Processes box outline color
theme[proc_box]="#474747"

# Box divider line and small boxes line color
theme[div_line]="#474747"

# Temperature graph colors
theme[temp_start]="#ffffff"
theme[temp_mid]="#c6c6c6"
theme[temp_end]="#e2e2e2"

# CPU graph colors
theme[cpu_start]="#ffffff"
theme[cpu_mid]="#c6c6c6"
theme[cpu_end]="#e2e2e2"

# Mem/Disk free meter
theme[free_start]="#c6c6c6"
theme[free_mid]="#c6c6c6"
theme[free_end]="#e2e2e2"

# Mem/Disk cached meter
theme[cached_start]="#c6c6c6"
theme[cached_mid]="#c6c6c6"
theme[cached_end]="#e2e2e2"

# Mem/Disk available meter
theme[available_start]="#e2e2e2"
theme[available_mid]="#e2e2e2"
theme[available_end]="#ffffff"

# Mem/Disk used meter
theme[used_start]="#ffffff"
theme[used_mid]="#ffffff"
theme[used_end]="#c6c6c6"

# Download graph colors
theme[download_start]="#ffffff"
theme[download_mid]="#c6c6c6"
theme[download_end]="#e2e2e2"

# Upload graph colors
theme[upload_start]="#e2e2e2"
theme[upload_mid]="#c6c6c6"
theme[upload_end]="#ffffff"
