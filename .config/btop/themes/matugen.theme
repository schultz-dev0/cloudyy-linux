# Matugen btop template
# Theme: #83d2e5

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0e1416"

# Main text color
theme[main_fg]="#dee3e5"

# Title color for boxes
theme[title]="#83d2e5"

# Highlight color for listview items
theme[hi_fg]="#00363f"

# Background color of selected item in processes box
theme[selected_bg]="#83d2e5"

# Foreground color of selected item in processes box
theme[selected_fg]="#00363f"

# Color of inactive/disabled text
theme[inactive_fg]="#899295"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#bfc8cb"

# Background color of the percentage meters
theme[meter_bg]="#303637"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#b2cbd2"

# Cpu box outline color
theme[cpu_box]="#3f484b"

# Memory box outline color
theme[mem_box]="#3f484b"

# Net box outline color
theme[net_box]="#3f484b"

# Processes box outline color
theme[proc_box]="#3f484b"

# Box divider line and small boxes line color
theme[div_line]="#3f484b"

# Temperature graph colors
theme[temp_start]="#83d2e5"
theme[temp_mid]="#b2cbd2"
theme[temp_end]="#bdc5eb"

# CPU graph colors
theme[cpu_start]="#83d2e5"
theme[cpu_mid]="#b2cbd2"
theme[cpu_end]="#bdc5eb"

# Mem/Disk free meter
theme[free_start]="#b2cbd2"
theme[free_mid]="#b2cbd2"
theme[free_end]="#bdc5eb"

# Mem/Disk cached meter
theme[cached_start]="#b2cbd2"
theme[cached_mid]="#b2cbd2"
theme[cached_end]="#bdc5eb"

# Mem/Disk available meter
theme[available_start]="#bdc5eb"
theme[available_mid]="#bdc5eb"
theme[available_end]="#83d2e5"

# Mem/Disk used meter
theme[used_start]="#83d2e5"
theme[used_mid]="#83d2e5"
theme[used_end]="#b2cbd2"

# Download graph colors
theme[download_start]="#83d2e5"
theme[download_mid]="#b2cbd2"
theme[download_end]="#bdc5eb"

# Upload graph colors
theme[upload_start]="#bdc5eb"
theme[upload_mid]="#b2cbd2"
theme[upload_end]="#83d2e5"
