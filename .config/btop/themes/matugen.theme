# Matugen btop template
# Theme: #a9d291

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#11140f"

# Main text color
theme[main_fg]="#e1e4d9"

# Title color for boxes
theme[title]="#a9d291"

# Highlight color for listview items
theme[hi_fg]="#173807"

# Background color of selected item in processes box
theme[selected_bg]="#a9d291"

# Foreground color of selected item in processes box
theme[selected_fg]="#173807"

# Color of inactive/disabled text
theme[inactive_fg]="#8d9286"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c3c8bb"

# Background color of the percentage meters
theme[meter_bg]="#32362f"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bccbb0"

# Cpu box outline color
theme[cpu_box]="#43483e"

# Memory box outline color
theme[mem_box]="#43483e"

# Net box outline color
theme[net_box]="#43483e"

# Processes box outline color
theme[proc_box]="#43483e"

# Box divider line and small boxes line color
theme[div_line]="#43483e"

# Temperature graph colors
theme[temp_start]="#a9d291"
theme[temp_mid]="#bccbb0"
theme[temp_end]="#a0cfd0"

# CPU graph colors
theme[cpu_start]="#a9d291"
theme[cpu_mid]="#bccbb0"
theme[cpu_end]="#a0cfd0"

# Mem/Disk free meter
theme[free_start]="#bccbb0"
theme[free_mid]="#bccbb0"
theme[free_end]="#a0cfd0"

# Mem/Disk cached meter
theme[cached_start]="#bccbb0"
theme[cached_mid]="#bccbb0"
theme[cached_end]="#a0cfd0"

# Mem/Disk available meter
theme[available_start]="#a0cfd0"
theme[available_mid]="#a0cfd0"
theme[available_end]="#a9d291"

# Mem/Disk used meter
theme[used_start]="#a9d291"
theme[used_mid]="#a9d291"
theme[used_end]="#bccbb0"

# Download graph colors
theme[download_start]="#a9d291"
theme[download_mid]="#bccbb0"
theme[download_end]="#a0cfd0"

# Upload graph colors
theme[upload_start]="#a0cfd0"
theme[upload_mid]="#bccbb0"
theme[upload_end]="#a9d291"
