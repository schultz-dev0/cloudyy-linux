# Matugen btop template
# Theme: #b7d084

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#12140d"

# Main text color
theme[main_fg]="#e3e3d7"

# Title color for boxes
theme[title]="#b7d084"

# Highlight color for listview items
theme[hi_fg]="#253600"

# Background color of selected item in processes box
theme[selected_bg]="#b7d084"

# Foreground color of selected item in processes box
theme[selected_fg]="#253600"

# Color of inactive/disabled text
theme[inactive_fg]="#909284"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c6c8b9"

# Background color of the percentage meters
theme[meter_bg]="#34362e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c2caaa"

# Cpu box outline color
theme[cpu_box]="#45483c"

# Memory box outline color
theme[mem_box]="#45483c"

# Net box outline color
theme[net_box]="#45483c"

# Processes box outline color
theme[proc_box]="#45483c"

# Box divider line and small boxes line color
theme[div_line]="#45483c"

# Temperature graph colors
theme[temp_start]="#b7d084"
theme[temp_mid]="#c2caaa"
theme[temp_end]="#a0d0c8"

# CPU graph colors
theme[cpu_start]="#b7d084"
theme[cpu_mid]="#c2caaa"
theme[cpu_end]="#a0d0c8"

# Mem/Disk free meter
theme[free_start]="#c2caaa"
theme[free_mid]="#c2caaa"
theme[free_end]="#a0d0c8"

# Mem/Disk cached meter
theme[cached_start]="#c2caaa"
theme[cached_mid]="#c2caaa"
theme[cached_end]="#a0d0c8"

# Mem/Disk available meter
theme[available_start]="#a0d0c8"
theme[available_mid]="#a0d0c8"
theme[available_end]="#b7d084"

# Mem/Disk used meter
theme[used_start]="#b7d084"
theme[used_mid]="#b7d084"
theme[used_end]="#c2caaa"

# Download graph colors
theme[download_start]="#b7d084"
theme[download_mid]="#c2caaa"
theme[download_end]="#a0d0c8"

# Upload graph colors
theme[upload_start]="#a0d0c8"
theme[upload_mid]="#c2caaa"
theme[upload_end]="#b7d084"
