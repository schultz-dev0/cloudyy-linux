# Matugen btop template
# Theme: #96d5a6

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101510"

# Main text color
theme[main_fg]="#dfe4dc"

# Title color for boxes
theme[title]="#96d5a6"

# Highlight color for listview items
theme[hi_fg]="#00391c"

# Background color of selected item in processes box
theme[selected_bg]="#96d5a6"

# Foreground color of selected item in processes box
theme[selected_fg]="#00391c"

# Color of inactive/disabled text
theme[inactive_fg]="#8b938a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c0c9bf"

# Background color of the percentage meters
theme[meter_bg]="#313631"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#b6ccb9"

# Cpu box outline color
theme[cpu_box]="#414942"

# Memory box outline color
theme[mem_box]="#414942"

# Net box outline color
theme[net_box]="#414942"

# Processes box outline color
theme[proc_box]="#414942"

# Box divider line and small boxes line color
theme[div_line]="#414942"

# Temperature graph colors
theme[temp_start]="#96d5a6"
theme[temp_mid]="#b6ccb9"
theme[temp_end]="#a2ceda"

# CPU graph colors
theme[cpu_start]="#96d5a6"
theme[cpu_mid]="#b6ccb9"
theme[cpu_end]="#a2ceda"

# Mem/Disk free meter
theme[free_start]="#b6ccb9"
theme[free_mid]="#b6ccb9"
theme[free_end]="#a2ceda"

# Mem/Disk cached meter
theme[cached_start]="#b6ccb9"
theme[cached_mid]="#b6ccb9"
theme[cached_end]="#a2ceda"

# Mem/Disk available meter
theme[available_start]="#a2ceda"
theme[available_mid]="#a2ceda"
theme[available_end]="#96d5a6"

# Mem/Disk used meter
theme[used_start]="#96d5a6"
theme[used_mid]="#96d5a6"
theme[used_end]="#b6ccb9"

# Download graph colors
theme[download_start]="#96d5a6"
theme[download_mid]="#b6ccb9"
theme[download_end]="#a2ceda"

# Upload graph colors
theme[upload_start]="#a2ceda"
theme[upload_mid]="#b6ccb9"
theme[upload_end]="#96d5a6"
