{
  // Bar geometry
  "bar": {
    "position": "bottom",
    "size": 90, // tall enough for magnified icons (icon_size * max_scale + padding)
    "autohide": true,
    "autohide_delay_ms": 800,
    "autohide_trigger_size": 2,
    "margin": {
      "top": 0,
      "bottom": 0,
      "left": 0,
      "right": 0
    }
  },
  // Which modules appear in each section
  "modules": {
    "left": [],
    "center": [
      "dock"
    ],
    "right": []
  },
  "dock": {
    "icon_size": 45,
    "max_scale": 1.6,
    "scale_curve": "gaussian",
    "spread": 0.4,
    "kill_button_enabled": true,
    "opacity": 0.5
  },
  // Spotlight search overlay
  "spotlight": {
    "exec": "anyrun",
    "icon": "system-search",
    "search": {
      "opacity": 0.20
    },
    "menu": {
      "opacity": 0.45
    }
  },
  // Pinned launcher apps
  "apps": {
    "pinned": [
      {
        "name": "Firefox",
        "command": "firefox",
        "icon": "firefox",
        "menu": [
          {
            "label": "New Tab",
            "command": "firefox --new-tab"
          },
          {
            "label": "New Private Window",
            "command": "firefox --private-window"
          }
        ]
      },
      {
        "name": "Terminal",
        "command": "kitty",
        "icon": "utilities-terminal"
      },
      {
        "name": "Obsidian",
        "command": "obsidian daily",
        "icon": "obsidian"
      },
      {
        "name": "Files",
        "command": "thunar",
        "icon": "system-file-manager"
      }
    ]
  }
}
