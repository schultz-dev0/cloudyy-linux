{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "left",
  "width": 44,
  "spacing": 0,
  "margin-top": 6,
  "margin-bottom": 6,
  "margin-left": 6,
  "margin-right": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "battery",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "·",
    "persistent-workspaces": {
      "*": 5
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "clock": {
    "min-width": 34,
    "format": "{:%H}\n{:%M}",
    "format-alt": "{:%a\n%d}",
    "interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click-right": "uwsm-app -- gnome-clocks",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffb786'><b>{}</b></span>",
        "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    }
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "tooltip-format": "{timeTo}\nHealth: {health}%",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power"
  }
}