{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "left",
  "width": 56, 
  "spacing": 0,
  "margin-top": 6,
  "margin-bottom": 6,
  "margin-left": 6,
  "margin-right": 0,
  
  // TOP SECTION: Clock -> Stats -> Notification
  "modules-left": [
    "clock",
    "custom/notification"
  ],

  // MIDDLE SECTION: Workspaces
  "modules-center": [
    "hyprland/workspaces"
  ],

  // BOTTOM SECTION: Network -> Audio -> Battery -> Power
  "modules-right": [
    "custom/updates",
    "network",
    "pulseaudio#output",
    "battery",
    "custom/power"
  ],

  // ──────────────────────────────────────────────────────────────────────────
  // MODULE CONFIGURATION
  // ──────────────────────────────────────────────────────────────────────────

  "clock": {
    "min-width": 46,
    // Matches reference: Hours over Minutes
    "format": "{:%H\n%M}",
    "tooltip-format": "<tt><span size='12pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffb786'><b>{}</b></span>",
        "days":     "<span color='#e2e2e2'>{}</span>",
        "weeks":    "<span color='#c9ca93'>W{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today":    "<span color='#131313' background='#ffb786'><b> {} </b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱏧",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󱏧",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "Notifications"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    // Vertical list of numbers
    "format": "{name}", 
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "custom/updates": {
    // Stacked Box icon over number
    "format": "󰏔\n{}", 
    "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
    "interval": 3600,
    "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
    "tooltip-format": "System Updates"
  },

  "network": {
    // Stacked Wifi icon over %
    "format-wifi": "\n{signalStrength}", 
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰤨 {essid}\n󱑽 {signalStrength}%\n󰩟 {ipaddr}",
    "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "uwsm-app nm-connection-editor",
    "interval": 5
  },

  "pulseaudio#output": {
    // Stacked Speaker icon over %
    "format": " {icon}\n{volume}%", 
    "format-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "uwsm-app -- pavucontrol",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "on-click-right": "uwsm-app -- kitty --class cava -e cava",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%"
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
    "on-click-right": "uwsm-app -- kitty --class timeout.sh -e $HOME/user_scripts/hypridle/timeout.sh",
    // Stacked Battery icon over %
    "format": "{icon}\n{capacity}", 
    "format-charging": "󰂄\n{capacity}",
    "format-plugged": "󰚥\n{capacity}",
    "format-full": "󰁹\nFull",
    "tooltip-format": "{timeTo}\nHealth: {health}%",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power Menu"
  }
}
