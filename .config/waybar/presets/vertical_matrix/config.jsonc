{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": false,
  "position": "left",
  "width": 60,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/updates"
  ],
  "modules-center": [
    "clock",
    "custom/temps"
  ],
  "modules-right": [
    "network",
    "pulseaudio#output",
    "cpu",
    "memory",
    "battery",
    "custom/power"
  ],
  "custom/launcher": {
    "format": ">_",
    "on-click": "rofi -show drun",
    "tooltip-format": "[ launch ]"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "[{name}]",
    "persistent-workspaces": {
      "*": 5
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "custom/updates": {
    "format": "PKG\n{}",
    "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
    "interval": 3600,
    "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
    "tooltip-format": "Pending updates"
  },
  "clock": {
    "format": "{:%H}\n{:%M}\n{:%S}",
    "format-alt": "{:%a\n%d}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click-right": "uwsm-app -- gnome-clocks",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffb786'><b>{}</b></span>",
        "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    }
  },
  "custom/temps": {
    "exec": "~/.config/waybar/scripts/temps.py",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "tooltip": true
  },
  "network": {
    "format-wifi": "NET\n{signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "---",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "Ethernet\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "uwsm-app nm-connection-editor",
    "interval": 5
  },
  "pulseaudio#output": {
    "format": "VOL\n{volume}%",
    "format-muted": "---",
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU\n{usage}%",
    "on-click": "kitty -e btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "memory": {
    "interval": 2,
    "format": "RAM\n{percentage}%",
    "on-click": "kitty -e btop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "BAT\n{capacity}%",
    "format-charging": "CHG\n{capacity}%",
    "format-plugged": "PWR\n{capacity}%",
    "format-full": "✓\n100%",
    "tooltip-format": "{timeTo}\nHealth: {health}%",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "custom/power": {
    "format": "[X]",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power"
  }
}