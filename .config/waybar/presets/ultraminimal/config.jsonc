// waybar preset: ultraminimal
// The smallest possible useful bar.
// Left: clock. Centre: workspace dots. Right: volume + battery + power.
// Everything else removed.

{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": false,
  "position": "top",
  "spacing": 2,
  "height": 28,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 0,

  "modules-left": [
    "clock",
    "custom/notification"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "pulseaudio#output",
    "battery",
    "custom/power"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b}",
    "tooltip-format": "<tt><span size='10pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "on-click-right": "uwsm-app -- gnome-clocks",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffb786'><b>{}</b></span>",
        "days":     "<span color='#e2e2e2'>{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today":    "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    }
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱏧",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󱏧",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "Notifications"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active":  "●",
      "default": "○",
      "empty":   "·"
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "pulseaudio#output": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%"
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹",
    "tooltip-format": "{timeTo}",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power Menu"
  }
}
