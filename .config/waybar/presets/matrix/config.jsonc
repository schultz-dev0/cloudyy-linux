{
    "layer": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "spacing": 0,
    "height": 30,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/updates",
        "custom/notification"
    ],
    "modules-center": [
        "mpris",
        "clock",
        "custom/temps"
    ],
    "modules-right": [
        "network",
        "pulseaudio#output",
        "cpu",
        "memory",
        "bluetooth",
        "battery",
        "custom/power"
    ],
    "custom/launcher": {
        "format": ">_",
        "on-click": "~/cloudyy_scripts/rofi/applications.sh",
        "tooltip-format": "[ launch process ]"
    },
    "custom/temps": {
        "exec": "~/.config/waybar/scripts/temps.py",
        "return-type": "json",
        "format": "{}",
        "interval": 2,
        "tooltip": true
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<tt><span size='10pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
        "interval": 1,
        "on-click-right": "uwsm-app -- gnome-clocks",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#00ff41'><b>{}</b></span>",
                "days": "<span color='#aaff88'>{}</span>",
                "weekdays": "<span color='#00ff41'><b>{}</b></span>",
                "today": "<span color='#000000' background='#00ff41'><b>{}</b></span>"
            }
        }
    },
    "custom/updates": {
        "format": "PKG {}",
        "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
        "interval": 3600,
        "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
        "tooltip-format": "[ pending updates ]"
    },
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "NOTIF",
            "none": "NOTIF",
            "dnd-notification": "DND",
            "dnd-none": "DND",
            "inhibited-notification": "NOTIF",
            "inhibited-none": "NOTIF",
            "dnd-inhibited-notification": "DND",
            "dnd-inhibited-none": "DND"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "[{name}]",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "mpris": {
        "format": "\udb81\udf5a {title}",
        "format-paused": "\udb80\udfe4 {title}",
        "format-stopped": "",
        "max-length": 24,
        "tooltip-format": "[ {player} ]\n  {artist}\n  {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "network": {
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "ETH \udb80\ude00",
        "format-disconnected": "NET --",
        "tooltip-format-wifi": "[ network ]\n  ssid: {essid}\n  signal: {signalStrength}%\n  ip: {ipaddr}\n  rx: {bandwidthDownBits}\n  tx: {bandwidthUpBits}",
        "tooltip-format-ethernet": "[ network ]\n  mode: ethernet\n  ip: {ipaddr}",
        "tooltip-format-disconnected": "[ network ]\n  status: disconnected",
        "on-click": "uwsm-app nm-connection-editor",
        "interval": 5
    },
    "pulseaudio#output": {
        "format": "VOL {volume}%",
        "format-muted": "VOL ---",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "tooltip-format": "[ audio ]\n  volume: {volume}%"
    },
    "cpu": {
        "interval": 2,
        "format": "CPU {usage:3}%",
        "on-click": "kitty -e btop",
        "tooltip-format": "[ cpu ]\n  usage: {usage}%\n  load: {load}",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "interval": 2,
        "format": "RAM {used:0.1f}G",
        "on-click": "kitty -e btop",
        "tooltip-format": "[ memory ]\n  used: {used:0.2f}G\n  total: {total:0.2f}G\n  swap: {swapUsed:0.2f}G",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "format-connected-battery": "\udb80\udcb1 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "\udb80\udcb1 {device_alias}",
        "tooltip-format-enumerate-connected-battery": "\udb80\udcb1 {device_alias} ({device_battery_percentage}%)",
        "on-click": "uwsm-app -- blueman-manager",
        "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "PWR {capacity}%",
        "format-full": "BAT 100%",
        "tooltip-format": "[ battery ]\n  status: {timeTo}\n  health: {health}%\n  power: {power:.2f}W",
        "format-icons": [
            "\u2581",
            "\u2582",
            "\u2583",
            "\u2584",
            "\u2585",
            "\u2586",
            "\u2587",
            "\u2588",
            "\u2588",
            "\u2588",
            "\u2588"
        ]
    },
    "custom/power": {
        "format": "[X]",
        "on-click": "~/cloudyy_scripts/wlogout.sh",
        "tooltip-format": "[ shutdown ]"
    }
}