{
    "layer": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "left",
    "width": 58,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/notification",
        "custom/updates"
    ],
    "modules-center": [
        "clock",
        "custom/temps"
    ],
    "modules-right": [
        "network",
        "pulseaudio#output",
        "cpu",
        "memory",
        "bluetooth",
        "custom/peripheral_battery_icon",

        "custom/peripheral_battery_pct",
        "battery",
        "custom/power"
    ],
    "custom/launcher": {
        "format": " \udb80\udd5f ",
        "on-click": "~/cloudyy_scripts/rofi/applications.sh",
        "tooltip-format": "Launch"
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "\udb84\udd6b",
            "none": "\udb80\udc9a",
            "dnd-notification": "\udb84\udfe7",
            "dnd-none": "\udb84\udfe7",
            "inhibited-notification": "\udb84\udd6b",
            "inhibited-none": "\udb80\udc9a",
            "dnd-inhibited-notification": "\udb84\udfe7",
            "dnd-inhibited-none": "\udb84\udfe7"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/updates": {
        "format": "\udb80\udfd4\n{}",
        "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
        "interval": 3600,
        "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
        "tooltip-format": "Pending updates"
    },
    "clock": {
        "format": "{:%H\n%M}",
        "on-click": "uwsm-app -- gnome-clocks",
        "on-click-right": "uwsm-app -- gnome-clocks",
        "tooltip-format": "{:%A, %d %b %Y}"
    },
    "custom/temps": {
        "exec": "~/cloudyy_scripts/waybar/temps.py",
        "return-type": "json",
        "format": "{}",
        "interval": 2,
        "tooltip": true
    },
    "network": {
        "format-wifi": " \udb82\udd28\n{signalStrength}%",
        "format-ethernet": "\udb80\ude00",
        "format-disconnected": "\udb81\uddaa",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "Ethernet\n{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "uwsm-app -- ~/cloudyy_scripts/cloud-center --wifi",
        "interval": 5
    },
    "pulseaudio#output": {
        "format": " \udb81\udd7e\n{volume}%",
        "format-muted": "\udb81\udd81",
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "tooltip-format": "Volume: {volume}%"
    },
    "cpu": {
        "interval": 2,
        "format": " \udb80\udf5b\n{usage}%",
        "on-click": "kitty -e btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "interval": 2,
        "format": " \udb81\ude1a\n{percentage}%",
        "on-click": "kitty -e btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "format-connected-battery": "\udb80\udcb1",
        "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "\udb80\udcb1 {device_alias}",
        "on-click": "uwsm-app -- ~/cloudyy_scripts/cloud-center --bluetooth",
        "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": " {icon}\n{capacity}%",
        "format-charging": "\udb80\udc84\n{capacity}%",
        "format-plugged": "\udb81\udea5\n{capacity}%",
        "format-full": " \udb80\udc79\n100%",
        "tooltip-format": "{timeTo}\nHealth: {health}%",
        "format-icons": [
            "\u2581",
            "\u2582",
            "\u2583",
            "\u2584",
            "\u2585",
            "\u2586",
            "\u2587",
            "\u2588"
        ]
    },
    "custom/peripheral_battery_icon": {
        "exec": "~/cloudyy_scripts/waybar/peripheral_battery.py --icon",
        "return-type": "json",
        "format": "{text}",
        "align": 0.5,
        "justify": "center",
        "interval": 60,
        "tooltip": true
    },
    "custom/peripheral_battery_pct": {
        "exec": "~/cloudyy_scripts/waybar/peripheral_battery.py --percent",
        "return-type": "json",
        "format": "{text}",
        "align": 0.5,
        "justify": "center",
        "interval": 60,
        "tooltip": false
    },
    "custom/power": {
        "format": "\udb81\udc25",
        "on-click": "~/cloudyy_scripts/wlogout.sh",
        "tooltip-format": "Power"
    }
}