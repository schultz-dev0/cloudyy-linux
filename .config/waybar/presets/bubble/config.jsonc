// waybar preset: bubble
// Floating pill bar. Each module sits in its own coloured bubble.
// Workspaces rendered as filled circle dots. Only essential system
// modules — no weather, updates, pycharm, themeswitcher.

{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 3,
  "height": 42,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 0,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/temps"
  ],

  "modules-center": [
    "mpris",
    "clock",
    "custom/timer"
  ],

  "modules-right": [
    "cpu",
    "pulseaudio#output",
    "network",
    "bluetooth",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰅟",
    "on-click": "rofi -show drun",
    "tooltip-format": "Application Launcher"
  },

  "custom/temps": {
    "exec": "~/.config/waybar/scripts/temps.py",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "tooltip": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "󰃭 {:%a %d %b}",
    "tooltip-format": "<tt><span size='11pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "on-click-right": "uwsm-app -- gnome-clocks",
    "on-click-middle": "uwsm-app -- kitty --class peaclock -e peaclock",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffb786'><b>{}</b></span>",
        "days":     "<span color='#e2e2e2'>{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today":    "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    }
  },

  "custom/timer": {
    "exec": "~/.config/waybar/scripts/timer.sh",
    "format": "{}",
    "interval": 1,
    "on-click": "echo $(( $(date +%s) + 7200 )) > /tmp/waybar_timer",
    "on-click-middle": "MINUTES=$(rofi -dmenu -p 'Set timer (minutes):'); if [[ $MINUTES =~ ^[0-9]+$ ]]; then echo $(( $(date +%s) + $MINUTES * 60 )) > /tmp/waybar_timer; fi",
    "on-click-right": "rm /tmp/waybar_timer",
    "on-scroll-up": "~/.config/waybar/scripts/timer.sh add",
    "on-scroll-down": "~/.config/waybar/scripts/timer.sh sub",
    "tooltip-format": "Left: 2h | Middle: Custom | Scroll: ±5m"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "󰏤 <i>{title}</i>",
    "format-stopped": "",
    "max-length": 20,
    "status-icons": { "paused": "󰏤" },
    "tooltip-format": "{player} — {artist}\n{title}\n{album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰤨 {essid}  {signalStrength}%\n󰩟 {ipaddr}",
    "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "uwsm-app nm-connection-editor",
    "interval": 5
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "on-click": "uwsm-app -- blueman-manager",
    "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
  },

  "pulseaudio#output": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "uwsm-app -- pavucontrol",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%\n MMB  Mute"
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "on-click": "kitty -e btop",
    "states": { "warning": 70, "critical": 90 }
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹",
    "tooltip-format": "{timeTo}\n󱟦 Health: {health}%",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power Menu"
  }
}
