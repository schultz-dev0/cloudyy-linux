{
    "layer": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "top",
    "spacing": 2,
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/timer",
        "custom/weather",
        "custom/updates",
        "custom/notification"
    ],
    "modules-center": [
        "mpris",
        "clock",
        "custom/temps"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio#output",
        "cpu",
        "memory",
        "battery",
        "tray",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "\udb80\udd5f ",
        "on-click": "~/cloudyy_scripts/rofi/applications.sh",
        "tooltip-format": "Application Launcher"
    },
    "custom/temps": {
        "exec": "~/.config/waybar/scripts/temps.py",
        "return-type": "json",
        "format": "{}",
        "interval": 2,
        "tooltip": true
    },
    "clock": {
        "format": "\udb82\udd54 {:%H:%M}",
        "format-alt": "\udb80\udced {:%a %d %b}",
        "tooltip-format": "<tt><span size='10pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
        "on-click-right": "uwsm-app -- gnome-clocks",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffb786'><b>{}</b></span>",
                "days": "<span color='#e2e2e2'>{}</span>",
                "weekdays": "<span color='#ffb786'><b>{}</b></span>",
                "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"
            }
        }
    },
    "custom/timer": {
        "exec": "~/.config/waybar/scripts/timer.sh",
        "format": "{}",
        "interval": 1,
        "on-click": "echo $(( $(date +%s) + 7200 )) > /tmp/waybar_timer",
        "on-click-middle": "MINUTES=$(rofi -dmenu -p 'Set timer (minutes):'); if [[ $MINUTES =~ ^[0-9]+$ ]]; then echo $(( $(date +%s) + $MINUTES * 60 )) > /tmp/waybar_timer; fi",
        "on-click-right": "rm /tmp/waybar_timer",
        "on-scroll-up": "~/.config/waybar/scripts/timer.sh add",
        "on-scroll-down": "~/.config/waybar/scripts/timer.sh sub",
        "tooltip-format": "Left: 2h | Middle: Custom | Scroll: +/- 5m"
    },
    "custom/weather": {
        "format": "{}",
        "exec": "curl -s 'wttr.in/?format=%c%t' | head -c 15",
        "interval": 1800,
        "tooltip-format": "Weather"
    },
    "custom/updates": {
        "format": "\udb80\udfd4 {}",
        "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
        "interval": 3600,
        "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
        "tooltip-format": "Pending updates"
    },
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "\udb84\udd6b",
            "none": "\udb80\udc9a",
            "dnd-notification": "\udb84\udfe7",
            "dnd-none": "\udb80\udc9b",
            "inhibited-notification": "\udb84\udd6b",
            "inhibited-none": "\udb80\udc9a",
            "dnd-inhibited-notification": "\udb84\udfe7",
            "dnd-inhibited-none": "\udb80\udc9b"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 14,
        "spacing": 4
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} <i>{title}</i>",
        "format-stopped": "",
        "max-length": 22,
        "status-icons": {
            "paused": "\udb80\udfe4"
        },
        "tooltip-format": "{player} \u2014 {artist}\n{title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "network": {
        "format-wifi": "\udb82\udd28  {bandwidthDownBits}",
        "format-ethernet": "\udb80\ude00  {bandwidthDownBits}",
        "format-disconnected": "\udb81\uddaa",
        "tooltip-format-wifi": "\udb82\udd28 {essid}  {signalStrength}%\n\udb82\ude5f {ipaddr}\n{bandwidthDownBits} down  {bandwidthUpBits} up",
        "tooltip-format-ethernet": "\udb80\ude00 Ethernet\n\udb82\ude5f {ipaddr}\n{bandwidthDownBits} down  {bandwidthUpBits} up",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "uwsm-app nm-connection-editor",
        "interval": 2
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "format-connected-battery": "\udb80\udcb1 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "\udb80\udcb1 {device_alias}",
        "tooltip-format-enumerate-connected-battery": "\udb80\udcb1 {device_alias} ({device_battery_percentage}%)",
        "on-click": "uwsm-app -- blueman-manager",
        "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
    },
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "\udb81\udd81 muted",
        "format-icons": {
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "tooltip-format": "Volume: {volume}%"
    },
    "cpu": {
        "interval": 2,
        "format": "\udb80\udf5b {usage}%",
        "on-click": "kitty -e btop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "interval": 2,
        "format": "\udb81\ude1a {percentage}%",
        "on-click": "uwsm-app -- kitty --class io_monitor.sh -e $HOME/user_scripts/drives/io_monitor.sh",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
        "format": "{icon} {capacity}%",
        "format-charging": "\udb80\udc84 {capacity}%",
        "format-plugged": "\udb81\udea5 {capacity}%",
        "format-full": "\udb80\udc79 Full",
        "tooltip-format": "{timeTo}\n\udb85\udfe6 Health: {health}%\n\udb85\udc0b {power:.2f}W",
        "format-icons": [
            "\udb80\udc8e",
            "\udb80\udc7a",
            "\udb80\udc7b",
            "\udb80\udc7c",
            "\udb80\udc7d",
            "\udb80\udc7e",
            "\udb80\udc7f",
            "\udb80\udc80",
            "\udb80\udc81",
            "\udb80\udc82",
            "\udb80\udc79"
        ]
    },
    "custom/power": {
        "format": "\udb81\udc25",
        "on-click": "~/cloudyy_scripts/wlogout.sh",
        "tooltip-format": "Power Menu"
    }
}