{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "left",
  "width": 54,
  "spacing": 0,
  "margin-top": 6,
  "margin-bottom": 6,
  "margin-left": 6,
  "margin-right": 0,

  "modules-left": [
    "custom/launcher",
    "clock",
    "custom/updates",
    "custom/notification",
    "custom/pycharm",
    "custom/themeswitcher"
  ],

  "modules-center": [
    "hyprland/workspaces",
    "custom/timer",
    "custom/temps",
    "custom/weather"
  ],

  "modules-right": [
    "mpris",
    "network",
    "bluetooth",
    "pulseaudio#output",
    "cpu",
    "memory",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰅟",
    "on-click": "rofi -show drun",
    "tooltip-format": "Application Launcher"
  },

  "custom/temps": {
    "exec": "~/.config/waybar/scripts/temps.py",
    "return-type": "json",
    "format": "{}",
    "rotate": 270,
    "interval": 2,
    "tooltip": true
  },

  "clock": {
    "min-width": 44,
    "format": "{:%I\n%M}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffb786'><b>{}</b></span>",
        "days":     "<span color='#e2e2e2'>{}</span>",
        "weeks":    "<span color='#c9ca93'>W{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today":    "<span color='#131313' background='#ffb786'><b> {} </b></span>"
      }
    }
  },

  "custom/themeswitcher": {
    "format": "󰔎",
    "on-click": "~/cloudyy_scripts/theme_controller.sh toggle",
    "tooltip-format": "Switch theme"
  },

  "custom/pycharm": {
    "format": "󱜙",
    "on-click": "pycharm &",
    "tooltip-format": "Launch PyCharm"
  },

  "custom/weather": {
    "format": "{}",
    "exec": "curl -s 'wttr.in/?format=%t' | head -c 15",
    "interval": 1800,
    "rotate": 270,
    "tooltip-format": "Weather Conditions"
  },

  "custom/updates": {
    "format": "󰏔\n{}",
    "exec": "checkupdates 2>/dev/null | wc -l || echo 0",
    "interval": 3600,
    "on-click": "kitty sh ~/cloudyy_scripts/cloudyy-updater.sh",
    "tooltip-format": "System Updates"
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱏧",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󱏧",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "tooltip-format": "Notifications\n\n LMB  Toggle Panel\n RMB  Do Not Disturb"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 6,
    "show-passive-items": true
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "format-stopped": "",
    "max-length": 25,
    "rotate": 270,
    "status-icons": { "paused": "󰏤" },
    "tooltip-format": "{player} - {artist}\n{title}\n{album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰤨 {essid}\n󱑽 {signalStrength}%\n󰩟 {ipaddr}",
    "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "uwsm-app nm-connection-editor",
    "interval": 5
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "󰂱 {device_alias}",
    "tooltip-format-enumerate-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "on-click": "uwsm-app -- blueman-manager",
    "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
  },

  "pulseaudio#output": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "uwsm-app -- pavucontrol",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "on-click-right": "uwsm-app -- kitty --class cava -e cava",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%\n\n LMB  Pavucontrol\n MMB  Mute\n RMB  Visualizer"
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛\n{usage}%",
    "on-click": "kitty -e btop",
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "interval": 2,
    "format": "󰘚\n{percentage}%",
    "on-click": "uwsm-app -- kitty --class io_monitor.sh -e $HOME/user_scripts/drives/io_monitor.sh",
    "states": { "warning": 70, "critical": 90 }
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "on-click": "uwsm-app -- kitty --class power_saver.sh --hold -e $HOME/user_scripts/battery/power_saving/power_saver.sh",
    "on-click-right": "uwsm-app -- kitty --class timeout.sh -e $HOME/user_scripts/hypridle/timeout.sh",
    "format": "{icon}\n{capacity}%",
    "format-charging": "󰂄\n {capacity}%",
    "format-plugged": "󰚥\n {capacity}%",
    "format-full": "󰁹",
    "tooltip-format": "{timeTo}\n\n󱟦 Health: {health}%\n󱐋 Power: {power:.2f}W",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "~/cloudyy_scripts/wlogout.sh",
    "tooltip-format": "Power Menu"
  }
}
