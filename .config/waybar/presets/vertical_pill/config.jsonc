// waybar preset: vertical_pill
// ─────────────────────────────────────────────────────────────────────────
// Vertical companion to pill. Three stacked pills on the left edge.
// Top: launcher + workspaces. Centre: clock + mpris. Bottom: system info.
// Clock splits HH/MM on two lines. Temp badge at the bottom.

{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "left",
  "width": 48,
  "spacing": 0,
  "margin-top": 10,
  "margin-bottom": 10,
  "margin-left": 8,
  "margin-right": 0,

  "modules-center": [
    "custom/launcher",
    "hyprland/workspaces",
    "clock",
    "mpris",
    "battery",
    "pulseaudio#output",
    "network",
    "custom/temps"
  ],

  "custom/launcher": {
    "format": "󰅟",
    "on-click": "rofi -show drun",
    "tooltip-format": "Application Launcher"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "<tt><span size='11pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "on-click-right": "uwsm-app -- gnome-clocks",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffb786'><b>{}</b></span>",
        "days":     "<span color='#e2e2e2'>{}</span>",
        "weekdays": "<span color='#ffb786'><b>{}</b></span>",
        "today":    "<span color='#131313' background='#ffb786'><b>{}</b></span>"
      }
    }
  },

  "mpris": {
    "format": "{player_icon}",
    "format-paused": "󰏤",
    "format-stopped": "",
    "status-icons": { "paused": "󰏤" },
    "tooltip-format": "{player} — {artist}\n{title}\n{album}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "format": "{icon}\n{capacity}%",
    "format-charging": "󰂄\n{capacity}%",
    "format-plugged": "󰚥\n{capacity}%",
    "format-full": "󰁹\n100%",
    "tooltip-format": "{timeTo}\n󱟦 Health: {health}%",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "pulseaudio#output": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "uwsm-app -- pavucontrol",
    "on-click-middle": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower",
    "tooltip-format": "Volume: {volume}%\n MMB  Mute"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "󰤨 {essid}  {signalStrength}%\n󰩟 {ipaddr}",
    "tooltip-format-ethernet": "󰈀 Ethernet\n󰩟 {ipaddr}",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "uwsm-app nm-connection-editor",
    "interval": 5
  },

  "custom/temps": {
    "exec": "~/.config/waybar/scripts/temps.py",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "tooltip": true
  }
}
