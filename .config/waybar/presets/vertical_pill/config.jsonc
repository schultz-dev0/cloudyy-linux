{
    "layer": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "position": "left",
    "width": 48,
    "spacing": 0,
    "margin-top": 10,
    "margin-bottom": 10,
    "margin-left": 8,
    "margin-right": 0,
    "modules-center": [
        "custom/launcher",
        "hyprland/workspaces",
        "clock",
        "mpris",
        "custom/peripheral_battery_icon",
        "custom/peripheral_battery_pct",
        "battery",
        "pulseaudio#output",
        "network",
        "custom/temps",
        "custom/power"
    ],
    "custom/launcher": {
        "format": " \udb80\udd5f ",
        "on-click": "~/cloudyy_scripts/rofi/applications.sh",
        "tooltip-format": "Application Launcher"
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock": {
        "format": "{:%H\n%M}",
        "on-click": "uwsm-app -- gnome-clocks",
        "on-click-right": "uwsm-app -- gnome-clocks",
        "tooltip-format": "{:%A, %d %b %Y}"
    },
    "mpris": {
        "format": "{player_icon}",
        "format-paused": "\udb80\udfe4",
        "format-stopped": "",
        "status-icons": {
            "paused": "\udb80\udfe4"
        },
        "tooltip-format": "{player} \u2014 {artist}\n{title}\n{album}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1 {num_connections}",
        "format-connected-battery": "\udb80\udcb1",
        "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "\udb80\udcb1 {device_alias}",
        "on-click": "uwsm-app -- ~/cloudyy_scripts/cloud-center --bluetooth",
        "on-click-right": "uwsm-app -- kitty --class bluetui -e bluetui"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": " {icon}\n{capacity}%",
        "format-charging": " \udb80\udc84\n{capacity}%",
        "format-plugged": " \udb81\udea5\n{capacity}%",
        "format-full": "\udb80\udc79",
        "tooltip-format": "{timeTo}\n\udb85\udfe6 Health: {health}%",
        "format-icons": [
            "\udb80\udc8e",
            "\udb80\udc7a",
            "\udb80\udc7b",
            "\udb80\udc7c",
            "\udb80\udc7d",
            "\udb80\udc7e",
            "\udb80\udc7f",
            "\udb80\udc80",
            "\udb80\udc81",
            "\udb80\udc82",
            "\udb80\udc79"
        ]
    },
    "pulseaudio#output": {
        "format": "{icon}",
        "format-muted": "\udb81\udd81",
        "format-icons": {
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
        "on-click": "uwsm-app -- ~/cloudyy_scripts/cloud-center --audio",
        "on-click-middle": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "tooltip-format": "Volume: {volume}%\n MMB  Mute"
    },
    "network": {
        "format-wifi": "\udb82\udd28",
        "format-ethernet": "\udb80\ude00",
        "format-disconnected": "\udb81\uddaa",
        "tooltip-format-wifi": "\udb82\udd28 {essid}  {signalStrength}%\n\udb82\ude5f {ipaddr}",
        "tooltip-format-ethernet": "\udb80\ude00 Ethernet\n\udb82\ude5f {ipaddr}",
        "tooltip-format-disconnected": "Not connected",
        "on-click": "uwsm-app -- ~/cloudyy_scripts/cloud-center --wifi",
        "interval": 5
    },
    "custom/temps": {
        "exec": "~/cloudyy_scripts/waybar/temps.py",
        "return-type": "json",
        "format": "{}",
        "interval": 2,
        "tooltip": true
    },
    "custom/peripheral_battery_icon": {
        "exec": "~/cloudyy_scripts/waybar/peripheral_battery.py --icon",
        "return-type": "json",
        "format": "{text}",
        "align": 0.5,
        "justify": "center",
        "interval": 60,
        "tooltip": true
    },
    "custom/power": {
        "format": "\u23fb",
        "on-click": "~/cloudyy_scripts/wlogout.sh",
        "tooltip-format": "Power"
    },
    "custom/peripheral_battery_pct": {
        "exec": "~/cloudyy_scripts/waybar/peripheral_battery.py --percent",
        "return-type": "json",
        "format": "{text}",
        "align": 0.5,
        "justify": "center",
        "interval": 60,
        "tooltip": false
    },
    "modules-left": [],
    "modules-right": []
}