/* Import Matugen Colors */\
@import url("../../matugen/generated/colors.css");\
\
* {\
    background-image: none;\
    box-shadow: none;\
}\
\
window {\
    background-color: rgba(12, 12, 12, 0.6);\
}\
\
button {\
    border-radius: 20px;\
    border-color: @primary_fixed;\
    color: @on_primary;\
    background-color: @primary;\
    border-style: solid;\
    border-width: 2px;\
    background-repeat: no-repeat;\
    background-position: center;\
    background-size: 25%;\
    margin: 10px;\
    transition: box-shadow 0.2s ease-in-out, background-color 0.2s ease-in-out;\
}\
\
button:focus, button:active, button:hover {\
    background-color: @secondary;\
    color: @on_secondary;\
    outline-style: none;\
}\
\
/* Map buttons to Standard GTK Icons */\
#lock { background-image: image(url("gtk-lock")); }\
#logout { background-image: image(url("gtk-leave")); }\
#suspend { background-image: image(url("gtk-media-pause")); }\
#reboot { background-image: image(url("gtk-refresh")); }\
#shutdown { background-image: image(url("gtk-quit")); }\
EOF
