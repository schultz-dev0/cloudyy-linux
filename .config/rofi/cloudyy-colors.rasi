/* Fixed Cloudyy Rofi palette. Curated theme activation never rewrites this file. */
* {
    glass-surface:       #161217B3;
    glass-input:         #2d282eCC;
    glass-selected:      #504255D9;
    glass-hover:         #231e2399;
    glass-message:       #231e23E6;

    error:               #ffb4ab;
    error-container:     #93000a;
    on-error-container:  #ffdad6;
    on-primary:          #442253;
    on-surface:          #e9e0e7;
    on-surface-variant:  #cec3cd;
    outline:             #978e97;
    outline-variant:     #4c444d;
    primary:             #e4b7f3;
}
