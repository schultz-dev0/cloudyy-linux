@import "~/.config/rofi/config.rasi"

/* ---- Configuration ---- */
configuration {
    modi: "drun,combi,window";
    show-icons: true;
    drun-display-format: "{name}";
}

/* ---- Window ---- */
window {
    transparency: "real";
    width: 60%;
    height: 70%;
    border-radius: 24px;
    
    background-color: @surface; 
    border: 2px;
    border-color: @outline;
    padding: 0px;
}

/* ---- Mainbox ---- */
mainbox {
    children: ["inputbar", "listview"];
    spacing: 20px;
    padding: 30px;
    background-color: transparent;
}

/* ---- Inputbar ---- */
inputbar {
    enabled: true;
    padding: 14px 20px;
    margin: 0px 0px 10px 0px;
    border-radius: 50px;
    background-color: @surface-container-high;
    border-color: @outline;
    border: 0px;
    
    children: ["prompt", "entry"];
}

prompt {
    enabled: true;
    padding: 0px 15px 0px 0px;
    background-color: transparent;
    text-color: @primary; 
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search Wallpapers...";
    placeholder-color: @on-surface-variant;
    background-color: transparent;
    text-color: @on-surface;
    cursor: text;
    vertical-align: 0.5;
}

/* ---- Listview ---- */
listview {
    columns: 4;
    lines: 2; 
    fixed-height: false;
    scrollbar: false;
    spacing: 20px;
    padding: 0px;
    cycle: false;
    dynamic: true;
    layout: vertical;
    
    background-color: transparent;
}

/* ---- Elements ---- */
element {
    orientation: vertical;
    padding: 15px;
    spacing: 10px;
    border-radius: 16px;
    cursor: pointer;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @surface-container-highest;
    text-color: @primary;
    border: 2px;
    border-color: @primary;
}

element-icon {
    size: 7em;
    horizontal-align: 0.5;
    background-color: transparent;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
}
