@import "colors.css";

:root {
    /* Zen Specific Variables - Force them everywhere */
    --zen-primary-color: var(--primary) !important;
    --zen-secondary-color: var(--secondary) !important;
    --zen-main-browser-background: var(--surface) !important;
    --zen-browser-background: var(--surface) !important;
    --zen-sidebar-background: var(--surface) !important;
    --zen-sidebar-border-color: var(--outline_variant) !important;
    
    /* Global Backgrounds for UI */
    --lwt-accent-color: var(--surface) !important;
    --lwt-text-color: var(--on_surface) !important;
    --toolbar-bgcolor: var(--surface) !important;
    --toolbar-color: var(--on_surface) !important;
}

/* Force everything in the navigator toolbox to be themed */
#navigator-toolbox, 
#nav-bar, 
#PersonalToolbar, 
#TabsToolbar, 
#toolbar-menubar,
#PersonalToolbar .toolbar-items,
#PersonalToolbar .toolbarbutton-1,
#PersonalToolbar .bookmark-item {
    background-color: var(--surface) !important;
    background-image: none !important;
    color: var(--on_surface) !important;
    appearance: none !important;
    border: none !important;
}

/* Bookmarks bar specific - sometimes needs extra punch */
#PersonalToolbar {
    min-height: 24px !important;
}

/* URL Bar */
#urlbar-background {
    background-color: var(--surface_container_high) !important;
    border: 1px solid var(--outline_variant) !important;
}

/* Zen Sidebar Active States */
.zen-workspace-item[zen-active="true"],
.zen-sidebar-button[zen-active="true"] {
    background-color: var(--primary_container) !important;
    color: var(--on_primary_container) !important;
}
