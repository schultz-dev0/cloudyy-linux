"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
palette = "matugen"

# Dynamic Material You Palette with optimized contrast for light/dark modes
[palettes.matugen]
surface = "{{colors.surface_container_highest.default.hex}}"
text = "{{colors.on_surface.default.hex}}"
text_muted = "{{colors.outline.default.hex}}"
primary = "{{colors.primary.default.hex}}"
secondary = "{{colors.secondary.default.hex}}"
tertiary = "{{colors.tertiary.default.hex}}"
error = "{{colors.error.default.hex}}"
warning = "{{colors.tertiary.default.hex}}"
outline = "{{colors.outline.default.hex}}"

# Left Prompt: Navigation and Version Control
format = """
$os\
$directory\
$git_branch\
$git_status\
$git_metrics\
$line_break\
$character"""

# Right Prompt: Environments, Toolchains, and Metrics
right_format = """
$memory_usage\
$conda\
$python\
$rust\
$cmd_duration\
$time\
"""

[os]
disabled = false
style = "bg:surface fg:primary"
format = "[](fg:surface)[$symbol]($style)[](fg:surface) "

[os.symbols]
Arch = " "
Macos = " "
Ubuntu = " "
Debian = " "

[directory]
style = "bg:surface fg:text"
format = "[](fg:surface)[ $path]($style)[](fg:surface) "
truncation_length = 3
truncation_symbol = "…/"

[git_branch]
style = "bg:surface fg:tertiary"
format = "[](fg:surface)[ $branch]($style)[](fg:surface) "

[git_status]
style = "bg:surface fg:error"
format = "[](fg:surface)[$all_status$ahead_behind]($style)[](fg:surface) "

[git_metrics]
disabled = false
added_style = "bg:surface fg:primary"
deleted_style = "bg:surface fg:error"
format = "[](fg:surface)[+$added]($added_style)[/-$deleted]($deleted_style)[](fg:surface) "

[memory_usage]
disabled = false
threshold = 70
style = "bg:surface fg:error"
format = "[](fg:surface)[󰍛 $ram]($style)[](fg:surface) "

[conda]
style = "bg:surface fg:secondary"
format = "[](fg:surface)[󰡏 $environment]($style)[](fg:surface) "

[python]
style = "bg:surface fg:secondary"
format = "[](fg:surface)[ $py_version]($style)[](fg:surface) "

[rust]
style = "bg:surface fg:secondary"
format = "[](fg:surface)[ $version]($style)[](fg:surface) "

[cmd_duration]
style = "bg:surface fg:text_muted"
format = "[](fg:surface)[󱎫 $duration]($style)[](fg:surface) "

[time]
disabled = false
time_format = "%T"
style = "bg:surface fg:text_muted"
format = "[](fg:surface)[ $time]($style)[](fg:surface) "

[character]
success_symbol = "[ ❯](bold primary)"
error_symbol = "[ ❯](bold error)"
vicmd_symbol = "[ ❮](bold secondary)"
