    "editorCursor.foreground": "{{colors.primary.default.hex}}",
    "editorWhitespace.foreground": "{{colors.surface_variant.default.hex}}",
    "editorLineNumber.foreground": "{{colors.on_surface_variant.default.hex}}",
    "editorLineNumber.activeForeground": "{{colors.primary.default.hex}}",
    "editorIndentGuide.background": "{{colors.surface_variant.default.hex}}",

    "breadcrumb.background": "{{colors.surface.default.hex}}",
    "breadcrumb.foreground": "{{colors.outline.default.hex}}",
    "breadcrumb.focusForeground": "{{colors.primary.default.hex}}",
    
    "activityBar.background": "{{colors.surface_container_lowest.default.hex}}",
    "activityBar.foreground": "{{colors.primary.default.hex}}",
    "activityBar.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
    "activityBarBadge.background": "{{colors.primary.default.hex}}",
    "activityBarBadge.foreground": "{{colors.on_primary.default.hex}}",
    
    "sideBar.background": "{{colors.surface_container_low.default.hex}}",
    "sideBar.foreground": "{{colors.on_surface.default.hex}}",
    "sideBarSectionHeader.background": "{{colors.surface_container.default.hex}}",

    "panel.background": "{{colors.surface.default.hex}}",
    "panel.border": "{{colors.outline_variant.default.hex}}",
    "panelTitle.activeForeground": "{{colors.on_surface.default.hex}}",
    "panelTitle.inactiveForeground": "{{colors.outline.default.hex}}",
    "panelInput.border": "{{colors.outline.default.hex}}",

    "chat.requestBackground": "{{colors.surface_container_low.default.hex}}",
    "chat.slashCommandForeground": "{{colors.primary.default.hex}}",

