    "editorLineNumber.activeForeground": "{{colors.primary.default.hex}}",
    
    "editorGutter.modifiedBackground": "{{colors.secondary.default.hex}}",
    "editorGutter.addedBackground": "{{colors.primary.default.hex}}",
    "editorGutter.deletedBackground": "{{colors.error.default.hex}}",
    
    "titleBar.activeBackground": "{{colors.surface_container_lowest.default.hex}}",
