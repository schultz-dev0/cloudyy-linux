  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "{{colors.outline.default.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "keyword",
          "storage.type",
          "storage.modifier",
          "variable.language"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "string",
          "punctuation.definition.string"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call"
        ],
        "settings": {
          "foreground": "{{colors.secondary.default.hex}}"
        }
      },
      {
        "scope": [
          "variable",
          "variable.other",
          "variable.other.property",
          "variable.other.object",
          "entity.name.variable",
          "support.variable"
        ],
        "settings": {
          "foreground": "{{colors.on_surface.default.hex}}"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language",
          "support.constant"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "keyword.operator",
          "keyword.operator.assignment",
          "keyword.operator.logical",
          "keyword.operator.arithmetic",
          "keyword.operator.comparison"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "punctuation",
          "meta.brace"
        ],
        "settings": {
          "foreground": "{{colors.on_surface_variant.default.hex}}"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "foreground": "{{colors.secondary.default.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.underline"
        ],
        "settings": {
          "fontStyle": "underline"
        }
      }
    ]
  }
}
