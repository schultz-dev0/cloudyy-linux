/**
 * @name Matugen_Bruteforce_Final
 * @description Comprehensive Matugen Colors via DOM structural targeting + Monocraft
 * @author Matugen
 */

/* 1. Global Variables */
:root, .theme-dark, .theme-light, .theme-midnight {
    /* Fonts */
    --font-primary: "Monocraft", "gg sans", sans-serif !important;
    --font-display: "Monocraft", "gg sans", sans-serif !important;
    --font-headline: "Monocraft", "gg sans", sans-serif !important;
    --font-code: "Monocraft", monospace !important;

    /* Text & Interactive Elements */
    --text-normal: {{colors.on_surface.default.hex}} !important;
    --text-muted: {{colors.outline.default.hex}} !important;
    --header-primary: {{colors.on_surface.default.hex}} !important;
    --interactive-normal: {{colors.outline.default.hex}} !important;
    --interactive-hover: {{colors.on_surface.default.hex}} !important;
    --interactive-active: {{colors.primary.default.hex}} !important;
    --brand-experiment: {{colors.primary.default.hex}} !important;

    /* Modifiers (Fixes context menus, tooltips, and selected channel highlights) */
    --background-modifier-hover: {{colors.surface_container_high.default.hex}} !important;
    --background-modifier-active: {{colors.surface_container_highest.default.hex}} !important;
    --background-modifier-selected: {{colors.secondary_container.default.hex}} !important;
    --background-modifier-accent: {{colors.surface_container_highest.default.hex}} !important;
    --background-floating: {{colors.surface_container_highest.default.hex}} !important;
    --background-nested-floating: {{colors.surface_container_highest.default.hex}} !important;

    /* Scrollbars */
    --scrollbar-auto-thumb: {{colors.primary.default.hex}} !important;
    --scrollbar-auto-track: transparent !important;
    --scrollbar-thin-thumb: {{colors.primary.default.hex}} !important;
}

/* 2. Brute-Force Structural Backgrounds */

/* App Title Bar (Very top window frame) */
[class^="titleBar_"],
[class^="withFrame_"] {
    background-color: {{colors.surface_container_lowest.default.hex}} !important;
}

/* Server List (Far Left) */
nav[class^="wrapper_"] {
    background-color: {{colors.surface_container_lowest.default.hex}} !important;
}

/* --- Channel Sidebar & Inner Lists --- */
[class^="sidebar_"], 
[class^="sidebar_"] > [class^="container_"],
[class^="sidebar_"] [class^="privateChannels_"],
[class^="sidebar_"] [class^="scroller_"],
header[class^="header_"] {
    background-color: {{colors.surface_container.default.hex}} !important;
    background: {{colors.surface_container.default.hex}} !important;
}

/* --- Main Chat Area --- */
[class^="chatContent_"], 
[class^="chat_"] {
    background-color: {{colors.surface.default.hex}} !important;
}

/* --- Top Bar / Chat Header --- */
section[class^="title_"],
[class^="subtitleContainer_"],
[class^="subtitleContainer_"] > section[class^="title_"],
[class^="chat_"] > [class^="title_"],
[class^="chat_"] > [class^="subtitleContainer_"] {
    background-color: {{colors.surface.default.hex}} !important;
    background: {{colors.surface.default.hex}} !important; /* Overrides gradient backgrounds */
}

/* --- App Window Title Bar (Very top frame) --- */
[class^="titleBar_"],
[class^="withFrame_"] {
    background-color: {{colors.surface_container_lowest.default.hex}} !important;
}

/* Member List (Right Sidebar) */
[class^="membersWrap_"], 
[class^="membersWrap_"] [class^="members_"],
[class^="membersWrap_"] > div {
    background-color: {{colors.surface_container_low.default.hex}} !important;
}

/* User Profile Panel (Bottom Left) */
[class^="panels_"],
[class^="panels_"] > [class^="container_"] {
    background-color: {{colors.surface_container_low.default.hex}} !important;
}

/* Message Input Box & Search Bars */
[class^="form_"]:before {
    display: none !important; /* Removes the hardcoded dark gradient fade above the chat box */
}
[class^="channelTextArea_"] [class^="scrollableContainer_"],
[class^="searchBar_"] {
    background-color: {{colors.surface_container_high.default.hex}} !important;
}

/* Settings View Structure */
[class^="layer_"] [class^="sidebarRegion_"] {
    background-color: {{colors.surface_container_lowest.default.hex}} !important;
}
[class^="layer_"] [class^="contentRegion_"] {
    background-color: {{colors.surface.default.hex}} !important;
}
