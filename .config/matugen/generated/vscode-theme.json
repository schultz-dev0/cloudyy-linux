    "selection.background": "#5c3f42",
    "errorForeground": "#ffb4ab",
    "titleBar.activeBackground": "#140c0d",
    "titleBar.activeForeground": "#f0dedf",
    "titleBar.inactiveBackground": "#140c0d",
    "titleBar.inactiveForeground": "#d7c1c2",
    
    "editorGroupHeader.tabsBackground": "#140c0d",
    "tab.activeBackground": "#1a1112",
    "tab.activeForeground": "#ffb2b9",
    "tab.activeBorderTop": "#ffb2b9",
    "tab.inactiveBackground": "#140c0d",
    "tab.inactiveForeground": "#d7c1c2",
    "tab.border": "#140c0d",

    "menu.background": "#271d1e",
    "menu.foreground": "#f0dedf",
    "menu.selectionBackground": "#5c3f42",
    "menu.selectionForeground": "#ffdadc",
    
    "editor.background": "#1a1112",
    "editor.foreground": "#f0dedf",
    "editor.lineHighlightBackground": "#312828",
    "editorCursor.foreground": "#ffb2b9",
    "editorWhitespace.foreground": "#524344",
    "editorLineNumber.foreground": "#d7c1c2",
    "editorLineNumber.activeForeground": "#ffb2b9",
    "editorIndentGuide.background": "#3d3233",
    
    "activityBar.background": "#140c0d",
    "activityBar.foreground": "#ffb2b9",
    "activityBar.inactiveForeground": "#d7c1c2",
    "activityBarBadge.background": "#ffb2b9",
    "activityBarBadge.foreground": "#561d26",
    
    "sideBar.background": "#22191a",
    "sideBar.foreground": "#f0dedf",
    "sideBarSectionHeader.background": "#271d1e",
    
    "statusBar.background": "#140c0d",
    "statusBar.foreground": "#f0dedf",
    "statusBar.debuggingBackground": "#e8c08e",
    "statusBar.debuggingForeground": "#442b06",
    "statusBar.noFolderBackground": "#271d1e",
    
    "terminal.background": "#1a1112",
    "terminal.foreground": "#f0dedf",
    "terminal.ansiBlack": "#3d3233",
    "terminal.ansiRed": "#ffb4ab",
    "terminal.ansiGreen": "#ffb2b9",
    "terminal.ansiYellow": "#e8c08e",
    "terminal.ansiBlue": "#e5bdbf",
    "terminal.ansiMagenta": "#ffdadc",
    "terminal.ansiCyan": "#ffdadc",
    "terminal.ansiWhite": "#f0dedf",
    
    "gitDecoration.modifiedResourceForeground": "#e5bdbf",
    "gitDecoration.untrackedResourceForeground": "#ffb2b9",
    "gitDecoration.deletedResourceForeground": "#ffb4ab",
    "gitDecoration.ignoredResourceForeground": "#9f8c8d"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "#9f8c8d",
          "fontStyle": "italic"
        }
      },
      {
        "scope": ["keyword", "storage.type", "storage.modifier", "variable.language"],
        "settings": {
          "foreground": "#ffb2b9",
          "fontStyle": "bold"
        }
      },
      {
        "scope": ["string", "punctuation.definition.string"],
        "settings": {
          "foreground": "#e8c08e"
        }
      },
      {
        "scope": ["entity.name.function", "support.function", "meta.function-call"],
        "settings": {
          "foreground": "#e5bdbf"
        }
      },
      {
        "scope": ["variable", "entity.name.variable", "support.variable"],
        "settings": {
          "foreground": "#f0dedf"
        }
      },
      {
        "scope": ["constant.numeric", "constant.language", "support.constant"],
        "settings": {
          "foreground": "#ffb4ab"
        }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": {
          "foreground": "#ffdadc"
        }
      },
      {
        "scope": ["punctuation", "meta.brace"],
        "settings": {
          "foreground": "#d7c1c2"
        }
      }
    ]
  }
}
