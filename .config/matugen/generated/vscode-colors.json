    "titleBar.inactiveBackground": "#120e07",
    "titleBar.inactiveForeground": "#d1c5b4",
    
    "editorGroupHeader.tabsBackground": "#120e07",
    "tab.activeBackground": "#17130b",
    "tab.activeForeground": "#edc06c",
    "tab.activeBorderTop": "#edc06c",
    "tab.inactiveBackground": "#120e07",
    "tab.inactiveForeground": "#d1c5b4",
    "tab.border": "#120e07",

    "menu.background": "#241f17",
    "menu.foreground": "#ece1d4",
    "menu.selectionBackground": "#54452a",
    "menu.selectionForeground": "#f7dfbb",
    
    "editor.background": "#17130b",
    "editor.foreground": "#ece1d4",
    "editor.lineHighlightBackground": "#2f2921",
    "editorCursor.foreground": "#edc06c",
    "editorWhitespace.foreground": "#4e4639",
    "editorLineNumber.foreground": "#d1c5b4",
    "editorLineNumber.activeForeground": "#edc06c",
    "editorIndentGuide.background": "#3a342b",
    
    "activityBar.background": "#120e07",
    "activityBar.foreground": "#edc06c",
    "activityBar.inactiveForeground": "#d1c5b4",
    "activityBarBadge.background": "#edc06c",
    "activityBarBadge.foreground": "#412d00",
    
    "sideBar.background": "#201b13",
    "sideBar.foreground": "#ece1d4",
    "sideBarSectionHeader.background": "#241f17",
    
    "statusBar.background": "#120e07",
    "statusBar.foreground": "#ece1d4",
    "statusBar.debuggingBackground": "#b3cea6",
    "statusBar.debuggingForeground": "#203619",
    "statusBar.noFolderBackground": "#241f17",
    
    "terminal.background": "#17130b",
    "terminal.foreground": "#ece1d4",
    "terminal.ansiBlack": "#3a342b",
    "terminal.ansiRed": "#ffb4ab",
    "terminal.ansiGreen": "#edc06c",
    "terminal.ansiYellow": "#b3cea6",
    "terminal.ansiBlue": "#dac4a0",
    "terminal.ansiMagenta": "#ffdea7",
    "terminal.ansiCyan": "#f7dfbb",
    "terminal.ansiWhite": "#ece1d4",
    
    "gitDecoration.modifiedResourceForeground": "#dac4a0",
    "gitDecoration.untrackedResourceForeground": "#edc06c",
    "gitDecoration.deletedResourceForeground": "#ffb4ab",
    "gitDecoration.ignoredResourceForeground": "#9a8f80"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "#9a8f80",
          "fontStyle": "italic"
        }
      },
      {
        "scope": ["keyword", "storage.type", "storage.modifier", "variable.language"],
        "settings": {
          "foreground": "#edc06c",
          "fontStyle": "bold"
        }
      },
      {
        "scope": ["string", "punctuation.definition.string"],
        "settings": {
          "foreground": "#b3cea6"
        }
      },
      {
        "scope": ["entity.name.function", "support.function", "meta.function-call"],
        "settings": {
          "foreground": "#dac4a0"
        }
      },
      {
        "scope": ["variable", "entity.name.variable", "support.variable"],
        "settings": {
          "foreground": "#ece1d4"
        }
      },
      {
        "scope": ["constant.numeric", "constant.language", "support.constant"],
        "settings": {
          "foreground": "#ffb4ab"
        }
      },
      {
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": {
          "foreground": "#ffdea7"
        }
      },
      {
        "scope": ["punctuation", "meta.brace"],
        "settings": {
          "foreground": "#d1c5b4"
        }
      }
    ]
  }
}
