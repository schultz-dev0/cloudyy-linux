
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #98ccf9;
    primary-fixed: #cce5ff;
    primary-fixed-dim: #98ccf9;
    on-primary: #003351;
    on-primary-fixed: #001e31;
    on-primary-fixed-variant: #064b72;
    primary-container: #064b72;
    on-primary-container: #cce5ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #b8c8da;
    secondary-fixed: #d4e4f6;
    secondary-fixed-dim: #b8c8da;
    on-secondary: #23323f;
    on-secondary-fixed: #0d1d2a;
    on-secondary-fixed-variant: #394857;
    secondary-container: #394857;
    on-secondary-container: #d4e4f6;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #d1bfe7;
    tertiary-fixed: #eddcff;
    tertiary-fixed-dim: #d1bfe7;
    on-tertiary: #372a4a;
    on-tertiary-fixed: #221534;
    on-tertiary-fixed-variant: #4e4162;
    tertiary-container: #4e4162;
    on-tertiary-container: #eddcff;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #101418;
    on-surface: #e0e2e8;
    on-surface-variant: #c2c7ce;
    outline: #8c9198;
    outline-variant: #42474e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e0e2e8;
    inverse-on-surface: #2d3135;
    inverse-primary: #2b638b;
    surface-dim: #101418;
    surface-bright: #363a3e;
    surface-container-lowest: #0b0f12;
    surface-container-low: #181c20;
    surface-container: #1c2024;
    surface-container-high: #272a2e;
    surface-container-highest: #313539;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #101418B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #272a2eCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #064b72D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1c202499;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1c2024CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #10141880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #10141899;  /* 60% opacity */
    glass-surface-heavy: #101418E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #181c20B3;  /* 70% */
    glass-container: #1c2024CC;  /* 80% */
    glass-container-high: #272a2eD9;  /* 85% */
    glass-container-highest: #313539E6;  /* 90% */
}

