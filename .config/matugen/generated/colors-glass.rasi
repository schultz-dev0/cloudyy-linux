
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #96d5a6;
    primary-fixed: #b1f1c1;
    primary-fixed-dim: #96d5a6;
    on-primary: #00391c;
    on-primary-fixed: #00210e;
    on-primary-fixed-variant: #11512e;
    primary-container: #11512e;
    on-primary-container: #b1f1c1;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #b6ccb9;
    secondary-fixed: #d2e8d4;
    secondary-fixed-dim: #b6ccb9;
    on-secondary: #223527;
    on-secondary-fixed: #0d1f13;
    on-secondary-fixed-variant: #384b3c;
    secondary-container: #384b3c;
    on-secondary-container: #d2e8d4;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #a2ceda;
    tertiary-fixed: #beeaf6;
    tertiary-fixed-dim: #a2ceda;
    on-tertiary: #023640;
    on-tertiary-fixed: #001f26;
    on-tertiary-fixed-variant: #214c57;
    tertiary-container: #214c57;
    on-tertiary-container: #beeaf6;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #101510;
    on-surface: #dfe4dc;
    on-surface-variant: #c0c9bf;
    outline: #8b938a;
    outline-variant: #414942;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe4dc;
    inverse-on-surface: #2c322d;
    inverse-primary: #2e6a44;
    surface-dim: #101510;
    surface-bright: #353a35;
    surface-container-lowest: #0a0f0b;
    surface-container-low: #181d18;
    surface-container: #1c211c;
    surface-container-high: #262b27;
    surface-container-highest: #313631;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #101510B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #262b27CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #11512eD9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1c211c99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1c211cCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #10151080;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #10151099;  /* 60% opacity */
    glass-surface-heavy: #101510E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #181d18B3;  /* 70% */
    glass-container: #1c211cCC;  /* 80% */
    glass-container-high: #262b27D9;  /* 85% */
    glass-container-highest: #313631E6;  /* 90% */
}

