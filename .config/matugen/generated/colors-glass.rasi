
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #a3c9fe;
    primary-fixed: #d3e4ff;
    primary-fixed-dim: #a3c9fe;
    on-primary: #00315c;
    on-primary-fixed: #001c38;
    on-primary-fixed-variant: #1e4876;
    primary-container: #1e4876;
    on-primary-container: #d3e4ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #bcc7db;
    secondary-fixed: #d8e3f8;
    secondary-fixed-dim: #bcc7db;
    on-secondary: #263141;
    on-secondary-fixed: #111c2b;
    on-secondary-fixed-variant: #3c4758;
    secondary-container: #3c4758;
    on-secondary-container: #d8e3f8;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #d8bde3;
    tertiary-fixed: #f5d9ff;
    tertiary-fixed-dim: #d8bde3;
    on-tertiary: #3c2947;
    on-tertiary-fixed: #261430;
    on-tertiary-fixed-variant: #543f5e;
    tertiary-container: #543f5e;
    on-tertiary-container: #f5d9ff;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #111418;
    on-surface: #e1e2e8;
    on-surface-variant: #c3c6cf;
    outline: #8d9199;
    outline-variant: #43474e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e2e8;
    inverse-on-surface: #2e3035;
    inverse-primary: #39608f;
    surface-dim: #111418;
    surface-bright: #37393e;
    surface-container-lowest: #0c0e13;
    surface-container-low: #191c20;
    surface-container: #1d2024;
    surface-container-high: #272a2f;
    surface-container-highest: #32353a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #111418B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #272a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #1e4876D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1d202499;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1d2024CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #11141880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #11141899;  /* 60% opacity */
    glass-surface-heavy: #111418E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #191c20B3;  /* 70% */
    glass-container: #1d2024CC;  /* 80% */
    glass-container-high: #272a2fD9;  /* 85% */
    glass-container-highest: #32353aE6;  /* 90% */
}

