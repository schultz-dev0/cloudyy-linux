
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #ffb2b9;
    primary-fixed: #ffdadc;
    primary-fixed-dim: #ffb2b9;
    on-primary: #561d26;
    on-primary-fixed: #3b0712;
    on-primary-fixed-variant: #72333b;
    primary-container: #72333b;
    on-primary-container: #ffdadc;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #e5bdbf;
    secondary-fixed: #ffdadc;
    secondary-fixed-dim: #e5bdbf;
    on-secondary: #44292c;
    on-secondary-fixed: #2c1517;
    on-secondary-fixed-variant: #5c3f42;
    secondary-container: #5c3f42;
    on-secondary-container: #ffdadc;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e8c08e;
    tertiary-fixed: #ffddb6;
    tertiary-fixed-dim: #e8c08e;
    on-tertiary: #442b06;
    on-tertiary-fixed: #2a1800;
    on-tertiary-fixed-variant: #5d411b;
    tertiary-container: #5d411b;
    on-tertiary-container: #ffddb6;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #1a1112;
    on-surface: #f0dedf;
    on-surface-variant: #d7c1c2;
    outline: #9f8c8d;
    outline-variant: #524344;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f0dedf;
    inverse-on-surface: #382e2e;
    inverse-primary: #8f4952;
    surface-dim: #1a1112;
    surface-bright: #413737;
    surface-container-lowest: #140c0d;
    surface-container-low: #22191a;
    surface-container: #271d1e;
    surface-container-high: #312828;
    surface-container-highest: #3d3233;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #1a1112B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #312828CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #72333bD9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #271d1e99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #271d1eCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #1a111280;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #1a111299;  /* 60% opacity */
    glass-surface-heavy: #1a1112E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #22191aB3;  /* 70% */
    glass-container: #271d1eCC;  /* 80% */
    glass-container-high: #312828D9;  /* 85% */
    glass-container-highest: #3d3233E6;  /* 90% */
}

