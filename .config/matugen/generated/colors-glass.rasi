
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #b6c4ff;
    primary-fixed: #dce1ff;
    primary-fixed-dim: #b6c4ff;
    on-primary: #1d2d61;
    on-primary-fixed: #04174b;
    on-primary-fixed-variant: #354479;
    primary-container: #354479;
    on-primary-container: #dce1ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c2c5dd;
    secondary-fixed: #dee1f9;
    secondary-fixed-dim: #c2c5dd;
    on-secondary: #2b3042;
    on-secondary-fixed: #161b2c;
    on-secondary-fixed-variant: #424659;
    secondary-container: #424659;
    on-secondary-container: #dee1f9;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e3bada;
    tertiary-fixed: #ffd7f5;
    tertiary-fixed-dim: #e3bada;
    on-tertiary: #43273f;
    on-tertiary-fixed: #2c122a;
    on-tertiary-fixed-variant: #5b3d57;
    tertiary-container: #5b3d57;
    on-tertiary-container: #ffd7f5;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #121318;
    on-surface: #e3e1e9;
    on-surface-variant: #c6c5d0;
    outline: #90909a;
    outline-variant: #45464f;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e1e9;
    inverse-on-surface: #2f3036;
    inverse-primary: #4d5c92;
    surface-dim: #121318;
    surface-bright: #38393f;
    surface-container-lowest: #0d0e13;
    surface-container-low: #1a1b21;
    surface-container: #1e1f25;
    surface-container-high: #292a2f;
    surface-container-highest: #34343a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #121318B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #292a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #354479D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1e1f2599;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1e1f25CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #12131880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #12131899;  /* 60% opacity */
    glass-surface-heavy: #121318E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1a1b21B3;  /* 70% */
    glass-container: #1e1f25CC;  /* 80% */
    glass-container-high: #292a2fD9;  /* 85% */
    glass-container-highest: #34343aE6;  /* 90% */
}

