
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #bac3ff;
    primary-fixed: #dee1ff;
    primary-fixed-dim: #bac3ff;
    on-primary: #222c61;
    on-primary-fixed: #0a164b;
    on-primary-fixed-variant: #394379;
    primary-container: #394379;
    on-primary-container: #dee1ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c3c5dd;
    secondary-fixed: #dfe1f9;
    secondary-fixed-dim: #c3c5dd;
    on-secondary: #2c2f42;
    on-secondary-fixed: #171a2c;
    on-secondary-fixed-variant: #434659;
    secondary-container: #434659;
    on-secondary-container: #dfe1f9;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e5bad8;
    tertiary-fixed: #ffd7f2;
    tertiary-fixed-dim: #e5bad8;
    on-tertiary: #44263e;
    on-tertiary-fixed: #2d1228;
    on-tertiary-fixed-variant: #5d3c55;
    tertiary-container: #5d3c55;
    on-tertiary-container: #ffd7f2;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #121318;
    on-surface: #e3e1e9;
    on-surface-variant: #c6c5d0;
    outline: #90909a;
    outline-variant: #46464f;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e1e9;
    inverse-on-surface: #303036;
    inverse-primary: #515b92;
    surface-dim: #121318;
    surface-bright: #38393f;
    surface-container-lowest: #0d0e13;
    surface-container-low: #1b1b21;
    surface-container: #1f1f25;
    surface-container-high: #292a2f;
    surface-container-highest: #34343a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #121318B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #292a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #394379D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1f1f2599;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1f1f25CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #12131880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #12131899;  /* 60% opacity */
    glass-surface-heavy: #121318E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1b1b21B3;  /* 70% */
    glass-container: #1f1f25CC;  /* 80% */
    glass-container-high: #292a2fD9;  /* 85% */
    glass-container-highest: #34343aE6;  /* 90% */
}

