
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #c0c7d5;
    primary-fixed: #dce3f2;
    primary-fixed-dim: #c0c7d5;
    on-primary: #29313c;
    on-primary-fixed: #151c26;
    on-primary-fixed-variant: #404753;
    primary-container: #404753;
    on-primary-container: #dce3f2;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c3c6cf;
    secondary-fixed: #dfe2eb;
    secondary-fixed-dim: #c3c6cf;
    on-secondary: #2c3137;
    on-secondary-fixed: #181c22;
    on-secondary-fixed-variant: #43474e;
    secondary-container: #43474e;
    on-secondary-container: #dfe2eb;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #bcc7db;
    tertiary-fixed: #d8e3f8;
    tertiary-fixed-dim: #bcc7db;
    on-tertiary: #263141;
    on-tertiary-fixed: #111c2b;
    on-tertiary-fixed-variant: #3c4758;
    tertiary-container: #3c4758;
    on-tertiary-container: #d8e3f8;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #131314;
    on-surface: #e4e2e3;
    on-surface-variant: #c8c6c7;
    outline: #919092;
    outline-variant: #474648;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e4e2e3;
    inverse-on-surface: #303031;
    inverse-primary: #575f6b;
    surface-dim: #131314;
    surface-bright: #39393a;
    surface-container-lowest: #0e0e0f;
    surface-container-low: #1b1b1d;
    surface-container: #1f1f21;
    surface-container-high: #2a2a2b;
    surface-container-highest: #353536;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #131314B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2a2a2bCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #404753D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1f1f2199;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1f1f21CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #13131480;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #13131499;  /* 60% opacity */
    glass-surface-heavy: #131314E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1b1b1dB3;  /* 70% */
    glass-container: #1f1f21CC;  /* 80% */
    glass-container-high: #2a2a2bD9;  /* 85% */
    glass-container-highest: #353536E6;  /* 90% */
}

