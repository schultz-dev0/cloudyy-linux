
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #ffb3ad;
    primary-fixed: #ffdad7;
    primary-fixed-dim: #ffb3ad;
    on-primary: #571e1b;
    on-primary-fixed: #3b0909;
    on-primary-fixed-variant: #733330;
    primary-container: #733330;
    on-primary-container: #ffdad7;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #e7bdb9;
    secondary-fixed: #ffdad7;
    secondary-fixed-dim: #e7bdb9;
    on-secondary: #442927;
    on-secondary-fixed: #2c1513;
    on-secondary-fixed-variant: #5d3f3d;
    secondary-container: #5d3f3d;
    on-secondary-container: #ffdad7;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e1c28c;
    tertiary-fixed: #ffdea6;
    tertiary-fixed-dim: #e1c28c;
    on-tertiary: #402d04;
    on-tertiary-fixed: #271900;
    on-tertiary-fixed-variant: #594319;
    tertiary-container: #594319;
    on-tertiary-container: #ffdea6;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #1a1111;
    on-surface: #f1dedd;
    on-surface-variant: #d8c2bf;
    outline: #a08c8a;
    outline-variant: #534342;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f1dedd;
    inverse-on-surface: #382e2d;
    inverse-primary: #904a46;
    surface-dim: #1a1111;
    surface-bright: #423736;
    surface-container-lowest: #140c0b;
    surface-container-low: #231919;
    surface-container: #271d1c;
    surface-container-high: #322827;
    surface-container-highest: #3d3231;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #1a1111B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #322827CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #733330D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #271d1c99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #271d1cCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #1a111180;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #1a111199;  /* 60% opacity */
    glass-surface-heavy: #1a1111E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #231919B3;  /* 70% */
    glass-container: #271d1cCC;  /* 80% */
    glass-container-high: #322827D9;  /* 85% */
    glass-container-highest: #3d3231E6;  /* 90% */
}

