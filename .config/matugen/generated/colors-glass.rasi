
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #b0c6ff;
    primary-fixed: #d9e2ff;
    primary-fixed-dim: #b0c6ff;
    on-primary: #162e60;
    on-primary-fixed: #001946;
    on-primary-fixed-variant: #2f4578;
    primary-container: #2f4578;
    on-primary-container: #d9e2ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c0c6dc;
    secondary-fixed: #dce2f9;
    secondary-fixed-dim: #c0c6dc;
    on-secondary: #2a3042;
    on-secondary-fixed: #151b2c;
    on-secondary-fixed-variant: #404659;
    secondary-container: #404659;
    on-secondary-container: #dce2f9;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e0bbdd;
    tertiary-fixed: #fdd7fa;
    tertiary-fixed-dim: #e0bbdd;
    on-tertiary: #412742;
    on-tertiary-fixed: #2a122c;
    on-tertiary-fixed-variant: #593d59;
    tertiary-container: #593d59;
    on-tertiary-container: #fdd7fa;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #121318;
    on-surface: #e2e2e9;
    on-surface-variant: #c5c6d0;
    outline: #8f9099;
    outline-variant: #44464f;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e2e9;
    inverse-on-surface: #2f3036;
    inverse-primary: #475d92;
    surface-dim: #121318;
    surface-bright: #38393f;
    surface-container-lowest: #0c0e13;
    surface-container-low: #1a1b20;
    surface-container: #1e1f25;
    surface-container-high: #282a2f;
    surface-container-highest: #33343a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #121318B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #282a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #2f4578D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1e1f2599;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1e1f25CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #12131880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #12131899;  /* 60% opacity */
    glass-surface-heavy: #121318E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1a1b20B3;  /* 70% */
    glass-container: #1e1f25CC;  /* 80% */
    glass-container-high: #282a2fD9;  /* 85% */
    glass-container-highest: #33343aE6;  /* 90% */
}

