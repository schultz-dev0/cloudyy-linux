
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #e8b6f0;
    primary-fixed: #fbd7ff;
    primary-fixed-dim: #e8b6f0;
    on-primary: #462151;
    on-primary-fixed: #2f0a3a;
    on-primary-fixed-variant: #5f3869;
    primary-container: #5f3869;
    on-primary-container: #fbd7ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #d6c0d6;
    secondary-fixed: #f3dbf3;
    secondary-fixed-dim: #d6c0d6;
    on-secondary: #3a2b3d;
    on-secondary-fixed: #241727;
    on-secondary-fixed-variant: #524154;
    secondary-container: #524154;
    on-secondary-container: #f3dbf3;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #f5b7b1;
    tertiary-fixed: #ffdad6;
    tertiary-fixed-dim: #f5b7b1;
    on-tertiary: #4c2522;
    on-tertiary-fixed: #33110e;
    on-tertiary-fixed-variant: #673b37;
    tertiary-container: #673b37;
    on-tertiary-container: #ffdad6;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #161217;
    on-surface: #eae0e7;
    on-surface-variant: #cfc3cd;
    outline: #988e97;
    outline-variant: #4c444c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #eae0e7;
    inverse-on-surface: #342f34;
    inverse-primary: #794f82;
    surface-dim: #161217;
    surface-bright: #3d373d;
    surface-container-lowest: #110d12;
    surface-container-low: #1f1a1f;
    surface-container: #231e23;
    surface-container-high: #2e282e;
    surface-container-highest: #393338;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #161217B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2e282eCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #5f3869D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #231e2399;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #231e23CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #16121780;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #16121799;  /* 60% opacity */
    glass-surface-heavy: #161217E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1f1a1fB3;  /* 70% */
    glass-container: #231e23CC;  /* 80% */
    glass-container-high: #2e282eD9;  /* 85% */
    glass-container-highest: #393338E6;  /* 90% */
}

