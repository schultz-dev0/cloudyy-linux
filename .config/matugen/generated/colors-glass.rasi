
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #adc6ff;
    primary-fixed: #d8e2ff;
    primary-fixed-dim: #adc6ff;
    on-primary: #102f60;
    on-primary-fixed: #001a41;
    on-primary-fixed-variant: #2b4678;
    primary-container: #2b4678;
    on-primary-container: #d8e2ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #bfc6dc;
    secondary-fixed: #dbe2f9;
    secondary-fixed-dim: #bfc6dc;
    on-secondary: #293041;
    on-secondary-fixed: #141b2c;
    on-secondary-fixed-variant: #3f4759;
    secondary-container: #3f4759;
    on-secondary-container: #dbe2f9;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #debcdf;
    tertiary-fixed: #fbd7fc;
    tertiary-fixed-dim: #debcdf;
    on-tertiary: #402843;
    on-tertiary-fixed: #29132d;
    on-tertiary-fixed-variant: #583e5b;
    tertiary-container: #583e5b;
    on-tertiary-container: #fbd7fc;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #111318;
    on-surface: #e2e2e9;
    on-surface-variant: #c4c6d0;
    outline: #8e9099;
    outline-variant: #44474f;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e2e9;
    inverse-on-surface: #2f3036;
    inverse-primary: #445e91;
    surface-dim: #111318;
    surface-bright: #37393e;
    surface-container-lowest: #0c0e13;
    surface-container-low: #1a1b20;
    surface-container: #1e1f25;
    surface-container-high: #282a2f;
    surface-container-highest: #33353a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #111318B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #282a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #2b4678D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1e1f2599;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1e1f25CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #11131880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #11131899;  /* 60% opacity */
    glass-surface-heavy: #111318E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1a1b20B3;  /* 70% */
    glass-container: #1e1f25CC;  /* 80% */
    glass-container-high: #282a2fD9;  /* 85% */
    glass-container-highest: #33353aE6;  /* 90% */
}

