
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #ffffff;
    primary-fixed: #5e5e5e;
    primary-fixed-dim: #474747;
    on-primary: #1b1b1b;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #e2e2e2;
    primary-container: #d4d4d4;
    on-primary-container: #000000;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c6c6c6;
    secondary-fixed: #c6c6c6;
    secondary-fixed-dim: #ababab;
    on-secondary: #1b1b1b;
    on-secondary-fixed: #1b1b1b;
    on-secondary-fixed-variant: #3b3b3b;
    secondary-container: #474747;
    on-secondary-container: #e2e2e2;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #e2e2e2;
    tertiary-fixed: #5e5e5e;
    tertiary-fixed-dim: #474747;
    on-tertiary: #1b1b1b;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #e2e2e2;
    tertiary-container: #919191;
    on-tertiary-container: #000000;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #131313;
    on-surface: #e2e2e2;
    on-surface-variant: #c6c6c6;
    outline: #919191;
    outline-variant: #474747;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e2e2e2;
    inverse-on-surface: #303030;
    inverse-primary: #5e5e5e;
    surface-dim: #131313;
    surface-bright: #393939;
    surface-container-lowest: #0e0e0e;
    surface-container-low: #1b1b1b;
    surface-container: #1f1f1f;
    surface-container-high: #2a2a2a;
    surface-container-highest: #353535;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #131313B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2a2a2aCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #d4d4d4D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1f1f1f99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1f1f1fCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #13131380;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #13131399;  /* 60% opacity */
    glass-surface-heavy: #131313E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1b1b1bB3;  /* 70% */
    glass-container: #1f1f1fCC;  /* 80% */
    glass-container-high: #2a2a2aD9;  /* 85% */
    glass-container-highest: #353535E6;  /* 90% */
}

