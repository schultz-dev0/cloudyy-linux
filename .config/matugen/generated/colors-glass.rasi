
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #92d5ab;
    primary-fixed: #adf2c6;
    primary-fixed-dim: #92d5ab;
    on-primary: #003921;
    on-primary-fixed: #002111;
    on-primary-fixed-variant: #065232;
    primary-container: #065232;
    on-primary-container: #adf2c6;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #b5ccbb;
    secondary-fixed: #d1e8d6;
    secondary-fixed-dim: #b5ccbb;
    on-secondary: #213528;
    on-secondary-fixed: #0b1f14;
    on-secondary-fixed-variant: #374b3e;
    secondary-container: #374b3e;
    on-secondary-container: #d1e8d6;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #a3cddc;
    tertiary-fixed: #bfe9f9;
    tertiary-fixed-dim: #a3cddc;
    on-tertiary: #043541;
    on-tertiary-fixed: #001f27;
    on-tertiary-fixed-variant: #224c59;
    tertiary-container: #224c59;
    on-tertiary-container: #bfe9f9;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #0f1511;
    on-surface: #dfe4dd;
    on-surface-variant: #c0c9c0;
    outline: #8a938b;
    outline-variant: #404942;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe4dd;
    inverse-on-surface: #2c322d;
    inverse-primary: #286a48;
    surface-dim: #0f1511;
    surface-bright: #353b36;
    surface-container-lowest: #0a0f0c;
    surface-container-low: #171d19;
    surface-container: #1b211d;
    surface-container-high: #262b27;
    surface-container-highest: #313632;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #0f1511B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #262b27CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #065232D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1b211d99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1b211dCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #0f151180;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #0f151199;  /* 60% opacity */
    glass-surface-heavy: #0f1511E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #171d19B3;  /* 70% */
    glass-container: #1b211dCC;  /* 80% */
    glass-container-high: #262b27D9;  /* 85% */
    glass-container-highest: #313632E6;  /* 90% */
}

