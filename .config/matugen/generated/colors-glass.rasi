
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #f0be6d;
    primary-fixed: #ffdead;
    primary-fixed-dim: #f0be6d;
    on-primary: #432c00;
    on-primary-fixed: #281900;
    on-primary-fixed-variant: #604100;
    primary-container: #604100;
    on-primary-container: #ffdead;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #dbc3a1;
    secondary-fixed: #f8dfbb;
    secondary-fixed-dim: #dbc3a1;
    on-secondary: #3d2e16;
    on-secondary-fixed: #261904;
    on-secondary-fixed-variant: #55442a;
    secondary-container: #55442a;
    on-secondary-container: #f8dfbb;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #b5cea4;
    tertiary-fixed: #d1eabf;
    tertiary-fixed-dim: #b5cea4;
    on-tertiary: #223618;
    on-tertiary-fixed: #0d2005;
    on-tertiary-fixed-variant: #374c2c;
    tertiary-container: #374c2c;
    on-tertiary-container: #d1eabf;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #17130b;
    on-surface: #ece1d4;
    on-surface-variant: #d2c4b4;
    outline: #9b8f80;
    outline-variant: #4e4539;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #ece1d4;
    inverse-on-surface: #362f27;
    inverse-primary: #7d570e;
    surface-dim: #17130b;
    surface-bright: #3f382f;
    surface-container-lowest: #120d07;
    surface-container-low: #201b13;
    surface-container: #241f17;
    surface-container-high: #2f2921;
    surface-container-highest: #3a342b;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #17130bB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2f2921CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #604100D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #241f1799;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #241f17CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #17130b80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #17130b99;  /* 60% opacity */
    glass-surface-heavy: #17130bE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #201b13B3;  /* 70% */
    glass-container: #241f17CC;  /* 80% */
    glass-container-high: #2f2921D9;  /* 85% */
    glass-container-highest: #3a342bE6;  /* 90% */
}

