
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #8bd0ef;
    primary-fixed: #bde9ff;
    primary-fixed-dim: #8bd0ef;
    on-primary: #003546;
    on-primary-fixed: #001f2a;
    on-primary-fixed-variant: #004d64;
    primary-container: #004d64;
    on-primary-container: #bde9ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #b4cad6;
    secondary-fixed: #d0e6f2;
    secondary-fixed-dim: #b4cad6;
    on-secondary: #1f333c;
    on-secondary-fixed: #081e27;
    on-secondary-fixed-variant: #354a53;
    secondary-container: #354a53;
    on-secondary-container: #d0e6f2;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #c6c2ea;
    tertiary-fixed: #e3dfff;
    tertiary-fixed-dim: #c6c2ea;
    on-tertiary: #2f2d4d;
    on-tertiary-fixed: #1a1836;
    on-tertiary-fixed-variant: #454364;
    tertiary-container: #454364;
    on-tertiary-container: #e3dfff;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #0f1417;
    on-surface: #dfe3e7;
    on-surface-variant: #c0c8cd;
    outline: #8a9297;
    outline-variant: #40484c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe3e7;
    inverse-on-surface: #2c3134;
    inverse-primary: #126682;
    surface-dim: #0f1417;
    surface-bright: #353a3d;
    surface-container-lowest: #0a0f11;
    surface-container-low: #171c1f;
    surface-container: #1b2023;
    surface-container-high: #262b2e;
    surface-container-highest: #303538;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #0f1417B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #262b2eCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #004d64D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1b202399;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1b2023CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #0f141780;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #0f141799;  /* 60% opacity */
    glass-surface-heavy: #0f1417E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #171c1fB3;  /* 70% */
    glass-container: #1b2023CC;  /* 80% */
    glass-container-high: #262b2eD9;  /* 85% */
    glass-container-highest: #303538E6;  /* 90% */
}

