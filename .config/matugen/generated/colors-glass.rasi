
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #ffb68a;
    primary-fixed: #ffdbc8;
    primary-fixed-dim: #ffb68a;
    on-primary: #522300;
    on-primary-fixed: #321300;
    on-primary-fixed-variant: #6f3810;
    primary-container: #6f3810;
    on-primary-container: #ffdbc8;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #e5bfa9;
    secondary-fixed: #ffdbc8;
    secondary-fixed-dim: #e5bfa9;
    on-secondary: #432b1c;
    on-secondary-fixed: #2b1709;
    on-secondary-fixed-variant: #5c4131;
    secondary-container: #5c4131;
    on-secondary-container: #ffdbc8;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #cbc992;
    tertiary-fixed: #e7e5ac;
    tertiary-fixed-dim: #cbc992;
    on-tertiary: #323209;
    on-tertiary-fixed: #1d1d00;
    on-tertiary-fixed-variant: #49491e;
    tertiary-container: #49491e;
    on-tertiary-container: #e7e5ac;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #1a120d;
    on-surface: #f0dfd7;
    on-surface-variant: #d7c2b8;
    outline: #9f8d84;
    outline-variant: #52443c;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f0dfd7;
    inverse-on-surface: #382e29;
    inverse-primary: #8b4f26;
    surface-dim: #1a120d;
    surface-bright: #413732;
    surface-container-lowest: #140d08;
    surface-container-low: #221a15;
    surface-container: #261e19;
    surface-container-high: #312823;
    surface-container-highest: #3d332d;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #1a120dB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #312823CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #6f3810D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #261e1999;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #261e19CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #1a120d80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #1a120d99;  /* 60% opacity */
    glass-surface-heavy: #1a120dE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #221a15B3;  /* 70% */
    glass-container: #261e19CC;  /* 80% */
    glass-container-high: #312823D9;  /* 85% */
    glass-container-highest: #3d332dE6;  /* 90% */
}

