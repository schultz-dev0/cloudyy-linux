
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #83d2e5;
    primary-fixed: #a7eeff;
    primary-fixed-dim: #83d2e5;
    on-primary: #00363f;
    on-primary-fixed: #001f25;
    on-primary-fixed-variant: #004e5b;
    primary-container: #004e5b;
    on-primary-container: #a7eeff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #b2cbd2;
    secondary-fixed: #cde7ee;
    secondary-fixed-dim: #b2cbd2;
    on-secondary: #1c3439;
    on-secondary-fixed: #051f24;
    on-secondary-fixed-variant: #334a50;
    secondary-container: #334a50;
    on-secondary-container: #cde7ee;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #bdc5eb;
    tertiary-fixed: #dce1ff;
    tertiary-fixed-dim: #bdc5eb;
    on-tertiary: #272f4d;
    on-tertiary-fixed: #121a37;
    on-tertiary-fixed-variant: #3e4565;
    tertiary-container: #3e4565;
    on-tertiary-container: #dce1ff;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #0e1416;
    on-surface: #dee3e5;
    on-surface-variant: #bfc8cb;
    outline: #899295;
    outline-variant: #3f484b;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dee3e5;
    inverse-on-surface: #2b3133;
    inverse-primary: #006878;
    surface-dim: #0e1416;
    surface-bright: #343a3c;
    surface-container-lowest: #090f11;
    surface-container-low: #171d1e;
    surface-container: #1b2122;
    surface-container-high: #252b2d;
    surface-container-highest: #303637;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #0e1416B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #252b2dCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #004e5bD9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1b212299;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1b2122CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #0e141680;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #0e141699;  /* 60% opacity */
    glass-surface-heavy: #0e1416E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #171d1eB3;  /* 70% */
    glass-container: #1b2122CC;  /* 80% */
    glass-container-high: #252b2dD9;  /* 85% */
    glass-container-highest: #303637E6;  /* 90% */
}

