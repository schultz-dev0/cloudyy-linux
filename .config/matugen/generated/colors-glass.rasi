
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #a9d291;
    primary-fixed: #c4efab;
    primary-fixed-dim: #a9d291;
    on-primary: #173807;
    on-primary-fixed: #062100;
    on-primary-fixed-variant: #2d4f1d;
    primary-container: #2d4f1d;
    on-primary-container: #c4efab;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #bccbb0;
    secondary-fixed: #d8e7cb;
    secondary-fixed-dim: #bccbb0;
    on-secondary: #283421;
    on-secondary-fixed: #131f0d;
    on-secondary-fixed-variant: #3e4a36;
    secondary-container: #3e4a36;
    on-secondary-container: #d8e7cb;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #a0cfd0;
    tertiary-fixed: #bbebec;
    tertiary-fixed-dim: #a0cfd0;
    on-tertiary: #003738;
    on-tertiary-fixed: #002020;
    on-tertiary-fixed-variant: #1e4e4f;
    tertiary-container: #1e4e4f;
    on-tertiary-container: #bbebec;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #11140f;
    on-surface: #e1e4d9;
    on-surface-variant: #c3c8bb;
    outline: #8d9286;
    outline-variant: #43483e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e4d9;
    inverse-on-surface: #2e312b;
    inverse-primary: #446732;
    surface-dim: #11140f;
    surface-bright: #373a33;
    surface-container-lowest: #0c0f0a;
    surface-container-low: #191d16;
    surface-container: #1d211a;
    surface-container-high: #282b24;
    surface-container-highest: #32362f;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #11140fB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #282b24CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #2d4f1dD9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1d211a99;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1d211aCC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #11140f80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #11140f99;  /* 60% opacity */
    glass-surface-heavy: #11140fE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #191d16B3;  /* 70% */
    glass-container: #1d211aCC;  /* 80% */
    glass-container-high: #282b24D9;  /* 85% */
    glass-container-highest: #32362fE6;  /* 90% */
}

