
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #b7d085;
    primary-fixed: #d2ec9f;
    primary-fixed-dim: #b7d085;
    on-primary: #243600;
    on-primary-fixed: #131f00;
    on-primary-fixed-variant: #394d11;
    primary-container: #394d11;
    on-primary-container: #d2ec9f;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #c2caab;
    secondary-fixed: #dee6c6;
    secondary-fixed-dim: #c2caab;
    on-secondary: #2c331d;
    on-secondary-fixed: #171e0a;
    on-secondary-fixed-variant: #424a32;
    secondary-container: #424a32;
    on-secondary-container: #dee6c6;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #a0d0c9;
    tertiary-fixed: #bcece5;
    tertiary-fixed-dim: #a0d0c9;
    on-tertiary: #013733;
    on-tertiary-fixed: #00201d;
    on-tertiary-fixed-variant: #1f4e49;
    tertiary-container: #1f4e49;
    on-tertiary-container: #bcece5;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #12140d;
    on-surface: #e3e3d8;
    on-surface-variant: #c6c8b9;
    outline: #8f9284;
    outline-variant: #45483d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e3d8;
    inverse-on-surface: #2f3129;
    inverse-primary: #506527;
    surface-dim: #12140d;
    surface-bright: #383a32;
    surface-container-lowest: #0d0f09;
    surface-container-low: #1a1c15;
    surface-container: #1e2019;
    surface-container-high: #292b23;
    surface-container-highest: #34362e;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #12140dB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #292b23CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #394d11D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1e201999;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1e2019CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #12140d80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #12140d99;  /* 60% opacity */
    glass-surface-heavy: #12140dE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1a1c15B3;  /* 70% */
    glass-container: #1e2019CC;  /* 80% */
    glass-container-high: #292b23D9;  /* 85% */
    glass-container-highest: #34362eE6;  /* 90% */
}

