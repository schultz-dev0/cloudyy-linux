
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #fdb975;
    primary-fixed: #ffdcbe;
    primary-fixed-dim: #fdb975;
    on-primary: #4a2800;
    on-primary-fixed: #2d1600;
    on-primary-fixed-variant: #693c00;
    primary-container: #693c00;
    on-primary-container: #ffdcbe;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #e1c1a4;
    secondary-fixed: #ffdcbe;
    secondary-fixed-dim: #e1c1a4;
    on-secondary: #402c18;
    on-secondary-fixed: #291806;
    on-secondary-fixed-variant: #59422c;
    secondary-container: #59422c;
    on-secondary-container: #ffdcbe;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #c0cc9a;
    tertiary-fixed: #dce8b4;
    tertiary-fixed-dim: #c0cc9a;
    on-tertiary: #2b3410;
    on-tertiary-fixed: #161e00;
    on-tertiary-fixed-variant: #414b24;
    tertiary-container: #414b24;
    on-tertiary-container: #dce8b4;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #19120c;
    on-surface: #efe0d5;
    on-surface-variant: #d5c3b5;
    outline: #9d8e81;
    outline-variant: #51453a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #efe0d5;
    inverse-on-surface: #372f28;
    inverse-primary: #865318;
    surface-dim: #19120c;
    surface-bright: #403830;
    surface-container-lowest: #130d07;
    surface-container-low: #211a14;
    surface-container: #261e18;
    surface-container-high: #302822;
    surface-container-highest: #3c332c;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #19120cB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #302822CC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #693c00D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #261e1899;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #261e18CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #19120c80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #19120c99;  /* 60% opacity */
    glass-surface-heavy: #19120cE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #211a14B3;  /* 70% */
    glass-container: #261e18CC;  /* 80% */
    glass-container-high: #302822D9;  /* 85% */
    glass-container-highest: #3c332cE6;  /* 90% */
}

