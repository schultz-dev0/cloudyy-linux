
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #9fcafc;
    primary-fixed: #d0e4ff;
    primary-fixed-dim: #9fcafc;
    on-primary: #003256;
    on-primary-fixed: #001d35;
    on-primary-fixed-variant: #164974;
    primary-container: #164974;
    on-primary-container: #d0e4ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #bac8db;
    secondary-fixed: #d6e4f7;
    secondary-fixed-dim: #bac8db;
    on-secondary: #243140;
    on-secondary-fixed: #0f1d2a;
    on-secondary-fixed-variant: #3b4857;
    secondary-container: #3b4857;
    on-secondary-container: #d6e4f7;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #d5bee5;
    tertiary-fixed: #f1daff;
    tertiary-fixed-dim: #d5bee5;
    on-tertiary: #3a2948;
    on-tertiary-fixed: #241432;
    on-tertiary-fixed-variant: #514060;
    tertiary-container: #514060;
    on-tertiary-container: #f1daff;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #101418;
    on-surface: #e1e2e8;
    on-surface-variant: #c2c7cf;
    outline: #8c9199;
    outline-variant: #42474e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e2e8;
    inverse-on-surface: #2d3135;
    inverse-primary: #34618d;
    surface-dim: #101418;
    surface-bright: #36393e;
    surface-container-lowest: #0b0e12;
    surface-container-low: #191c20;
    surface-container: #1d2024;
    surface-container-high: #272a2f;
    surface-container-highest: #32353a;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #101418B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #272a2fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #164974D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #1d202499;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #1d2024CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #10141880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #10141899;  /* 60% opacity */
    glass-surface-heavy: #101418E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #191c20B3;  /* 70% */
    glass-container: #1d2024CC;  /* 80% */
    glass-container-high: #272a2fD9;  /* 85% */
    glass-container-highest: #32353aE6;  /* 90% */
}

