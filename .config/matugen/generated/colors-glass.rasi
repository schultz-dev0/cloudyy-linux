
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #d8bafb;
    primary-fixed: #eedcff;
    primary-fixed-dim: #d8bafb;
    on-primary: #3c245a;
    on-primary-fixed: #260d44;
    on-primary-fixed-variant: #533b72;
    primary-container: #533b72;
    on-primary-container: #eedcff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #cfc1da;
    secondary-fixed: #ecddf7;
    secondary-fixed-dim: #cfc1da;
    on-secondary: #352d40;
    on-secondary-fixed: #20182a;
    on-secondary-fixed-variant: #4c4357;
    secondary-container: #4c4357;
    on-secondary-container: #ecddf7;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #f2b7c1;
    tertiary-fixed: #ffd9de;
    tertiary-fixed-dim: #f2b7c1;
    on-tertiary: #4b252d;
    on-tertiary-fixed: #321018;
    on-tertiary-fixed-variant: #653b43;
    tertiary-container: #653b43;
    on-tertiary-container: #ffd9de;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #151218;
    on-surface: #e7e0e8;
    on-surface-variant: #ccc4cf;
    outline: #958e99;
    outline-variant: #4a454e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e7e0e8;
    inverse-on-surface: #332f35;
    inverse-primary: #6c538c;
    surface-dim: #151218;
    surface-bright: #3b383e;
    surface-container-lowest: #100d12;
    surface-container-low: #1d1a20;
    surface-container: #211e24;
    surface-container-high: #2c292f;
    surface-container-highest: #373339;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #151218B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2c292fCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #533b72D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #211e2499;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #211e24CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #15121880;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #15121899;  /* 60% opacity */
    glass-surface-heavy: #151218E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1d1a20B3;  /* 70% */
    glass-container: #211e24CC;  /* 80% */
    glass-container-high: #2c292fD9;  /* 85% */
    glass-container-highest: #373339E6;  /* 90% */
}

