
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT */
  

* {
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #5c5891;
    primary-fixed: #e3dfff;
    primary-fixed-dim: #c5c0ff;
    on-primary: #ffffff;
    on-primary-fixed: #18124a;
    on-primary-fixed-variant: #444078;
    primary-container: #e3dfff;
    on-primary-container: #18124a;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #5e5c71;
    secondary-fixed: #e4dff9;
    secondary-fixed-dim: #c8c4dc;
    on-secondary: #ffffff;
    on-secondary-fixed: #1b1a2c;
    on-secondary-fixed-variant: #464559;
    secondary-container: #e4dff9;
    on-secondary-container: #1b1a2c;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #7b5267;
    tertiary-fixed: #ffd8e9;
    tertiary-fixed-dim: #ebb8d0;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #2f1122;
    on-tertiary-fixed-variant: #613b4f;
    tertiary-container: #ffd8e9;
    on-tertiary-container: #2f1122;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #fcf8ff;
    on-surface: #1c1b20;
    on-surface-variant: #47464f;
    outline: #787680;
    outline-variant: #c8c5d0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #313036;
    inverse-on-surface: #f3eff7;
    inverse-primary: #c5c0ff;
    surface-dim: #dcd8e0;
    surface-bright: #fcf8ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f6f2fa;
    surface-container: #f0ecf4;
    surface-container-high: #ebe7ef;
    surface-container-highest: #e5e1e9;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #fcf8ffB3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #ebe7efCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity */
    glass-selected: #e3dfffD9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #f0ecf499;  /* 60% opacity */
    
    /* Message boxes */
    glass-message: #f0ecf4CC;  /* 80% opacity */
    
    /* Alternative for even more transparency */
    glass-surface-light: #fcf8ff80;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #fcf8ff99;  /* 60% opacity */
    glass-surface-heavy: #fcf8ffE6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #f6f2faB3;  /* 70% */
    glass-container: #f0ecf4CC;  /* 80% */
    glass-container-high: #ebe7efD9;  /* 85% */
    glass-container-highest: #e5e1e9E6;  /* 90% */
}

