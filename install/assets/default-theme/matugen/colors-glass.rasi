
 /* MATUGEN GENERATED COLORS - LIQUID GLASS EFFECT WITH LIGHT MODE SUPPORT */
  

* {
    /* =====================================================================
       TEXT COLORS - CRITICAL FOR READABILITY
       ===================================================================== */
    text-normal: #e9e0e7;
    text-secondary: #978e97;
    text-faint: #4c444d;
    
    /* =====================================================================
       PRIMARY COLORS - WITH TRANSPARENCY
       ===================================================================== */
    
    /* Solid reference colors (for borders, accents) */
    primary: #e4b7f3;
    primary-fixed: #f8d8ff;
    primary-fixed-dim: #e4b7f3;
    on-primary: #442253;
    on-primary-fixed: #2d0b3d;
    on-primary-fixed-variant: #5c386b;
    primary-container: #5c386b;
    on-primary-container: #f8d8ff;
    
    /* =====================================================================
       SECONDARY COLORS
       ===================================================================== */
    
    secondary: #d4c0d7;
    secondary-fixed: #f1dcf4;
    secondary-fixed-dim: #d4c0d7;
    on-secondary: #392c3d;
    on-secondary-fixed: #231728;
    on-secondary-fixed-variant: #504255;
    secondary-container: #504255;
    on-secondary-container: #f1dcf4;
    
    /* =====================================================================
       TERTIARY COLORS
       ===================================================================== */
    
    tertiary: #f5b7b5;
    tertiary-fixed: #ffdad8;
    tertiary-fixed-dim: #f5b7b5;
    on-tertiary: #4c2524;
    on-tertiary-fixed: #331111;
    on-tertiary-fixed-variant: #663b3a;
    tertiary-container: #663b3a;
    on-tertiary-container: #ffdad8;
    
    /* =====================================================================
       ERROR COLORS
       ===================================================================== */
    
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    
    /* =====================================================================
       SURFACE COLORS - SOLID (for reference)
       ===================================================================== */
    
    surface: #161217;
    on-surface: #e9e0e7;
    on-surface-variant: #cec3cd;
    outline: #978e97;
    outline-variant: #4c444d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e9e0e7;
    inverse-on-surface: #342f34;
    inverse-primary: #765085;
    surface-dim: #161217;
    surface-bright: #3d373d;
    surface-container-lowest: #110d12;
    surface-container-low: #1f1a1f;
    surface-container: #231e23;
    surface-container-high: #2d282e;
    surface-container-highest: #383339;
    
    /* =====================================================================
       LIQUID GLASS VARIANTS - WITH ALPHA TRANSPARENCY
       Adjusted for proper contrast in light/dark modes
       75% = CC (204), 80% = CC, 85% = D9, 90% = E6, 95% = F2
       ===================================================================== */
    
    /* Main window background - Very transparent for glass effect */
    glass-surface: #161217B3;  /* 70% opacity */
    
    /* Input/search bar - Slightly more opaque for readability */
    glass-input: #2d282eCC;  /* 80% opacity */
    
    /* Selected items - Medium opacity with proper contrast */
    glass-selected: #504255D9;  /* 85% opacity */
    
    /* Hover state - Light opacity */
    glass-hover: #231e2399;  /* 60% opacity */
    
    /* Message boxes - Better contrast */
    glass-message: #231e23E6;  /* 90% opacity */
    
    /* Alternative transparency levels */
    glass-surface-light: #16121780;  /* 50% opacity - ultra transparent */
    glass-surface-medium: #16121799;  /* 60% opacity */
    glass-surface-heavy: #161217E6;  /* 90% opacity - barely transparent */
    
    /* Container variations with transparency */
    glass-container-low: #1f1a1fB3;  /* 70% */
    glass-container: #231e23CC;  /* 80% */
    glass-container-high: #2d282eD9;  /* 85% */
    glass-container-highest: #383339E6;  /* 90% */
}

