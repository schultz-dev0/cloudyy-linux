// Cloudyy Plymouth theme
// Locked palette (do not change without updating cloud-center contract test):
//   bg     #112533
//   field  #1a3548
//   border #2a4a63
//   muted  #8fa3b5
//   text   #e6eef4

bg_r = 0x11 / 255; bg_g = 0x25 / 255; bg_b = 0x33 / 255;       // #112533
text_r = 0xe6 / 255; text_g = 0xee / 255; text_b = 0xf4 / 255; // #e6eef4

Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

wordmark_image = Image.Text("CLOUDYY", text_r, text_g, text_b, 1, "Sans Bold 28");
wordmark_sprite = Sprite(wordmark_image);
wordmark_sprite.SetX(screen_width / 2 - wordmark_image.GetWidth() / 2);
wordmark_sprite.SetY(screen_height / 2 - wordmark_image.GetHeight() / 2 - 70);
wordmark_sprite.SetZ(10);

// Pill password field — pre-rendered PNG (fill 1a3548, border 2a4a63).
pill_image = Image("pill.png");
pill_x = screen_width / 2 - pill_image.GetWidth() / 2;
pill_y = screen_height / 2 - pill_image.GetHeight() / 2;
pill_sprite = Sprite(pill_image);
pill_sprite.SetX(pill_x);
pill_sprite.SetY(pill_y);
pill_sprite.SetZ(0);

bullet_image = Image("bullet.png");
bullet_gap = bullet_image.GetWidth() + 12;
max_bullets = 20;

bullets = null;

fun render_bullets(count) {
    bullets = null;

    if (count > max_bullets) {
        count = max_bullets;
    }

    total_width = count * bullet_gap;
    start_x = screen_width / 2 - total_width / 2;
    bullet_y = pill_y + pill_image.GetHeight() / 2 - bullet_image.GetHeight() / 2;

    for (i = 0; i < count; i++) {
        bullets[i] = Sprite(bullet_image);
        bullets[i].SetX(start_x + i * bullet_gap);
        bullets[i].SetY(bullet_y);
        bullets[i].SetZ(20);
    }
}

fun display_normal_callback() {
    render_bullets(0);
}

fun display_password_callback(prompt, bullet_count) {
    render_bullets(bullet_count);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);