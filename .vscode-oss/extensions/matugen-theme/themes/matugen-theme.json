{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#101418",
    "editor.foreground": "#e1e2e8",
    "activityBar.background": "#191c20",
    "sideBar.background": "#1d2024",
    "sideBar.border": "#42474e",
    "titleBar.activeBackground": "#101418",
    "statusBar.background": "#1d2024",
    "statusBar.foreground": "#e1e2e8",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#9fcafc",
    "activityBar.foreground": "#9fcafc",
    "textLink.foreground": "#9fcafc",
    "button.background": "#9fcafc",
    "button.foreground": "#003256",
    "inputOption.activeBorder": "#9fcafc",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#9fcafc40",
    "list.hoverBackground": "#e1e2e810",
    "list.activeSelectionForeground": "#9fcafc",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#101418",
    "tab.activeBackground": "#272a2f",
    "tab.inactiveBackground": "#101418",
    "tab.activeBorderTop": "#9fcafc"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c2c7cf" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e1e2e8" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#d5bee5" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#9fcafc" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#bac8db" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#d5bee5" }
    }
  ]
}
