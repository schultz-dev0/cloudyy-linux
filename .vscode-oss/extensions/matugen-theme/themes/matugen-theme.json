{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#11140e",
    "editor.foreground": "#e1e4d9",
    "activityBar.background": "#191d16",
    "sideBar.background": "#1d211a",
    "sideBar.border": "#43483e",
    "titleBar.activeBackground": "#11140e",
    "statusBar.background": "#1d211a",
    "statusBar.foreground": "#e1e4d9",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#aad291",
    "activityBar.foreground": "#aad291",
    "textLink.foreground": "#aad291",
    "button.background": "#aad291",
    "button.foreground": "#183807",
    "inputOption.activeBorder": "#aad291",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#aad29140",
    "list.hoverBackground": "#e1e4d910",
    "list.activeSelectionForeground": "#aad291",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#11140e",
    "tab.activeBackground": "#282b24",
    "tab.inactiveBackground": "#11140e",
    "tab.activeBorderTop": "#aad291"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c3c8bb" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e1e4d9" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#a0cfcf" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#aad291" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#bdcbaf" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#a0cfcf" }
    }
  ]
}
