{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#131318",
    "editor.foreground": "#e4e1e9",
    "activityBar.background": "#1b1b21",
    "sideBar.background": "#1f1f25",
    "sideBar.border": "#46464f",
    "titleBar.activeBackground": "#131318",
    "statusBar.background": "#1f1f25",
    "statusBar.foreground": "#e4e1e9",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#bfc1ff",
    "activityBar.foreground": "#bfc1ff",
    "textLink.foreground": "#bfc1ff",
    "button.background": "#bfc1ff",
    "button.foreground": "#282b60",
    "inputOption.activeBorder": "#bfc1ff",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#bfc1ff40",
    "list.hoverBackground": "#e4e1e910",
    "list.activeSelectionForeground": "#bfc1ff",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#131318",
    "tab.activeBackground": "#2a292f",
    "tab.inactiveBackground": "#131318",
    "tab.activeBorderTop": "#bfc1ff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c7c5d0" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e4e1e9" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#e8b9d4" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#bfc1ff" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#c5c4dd" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#e8b9d4" }
    }
  ]
}
