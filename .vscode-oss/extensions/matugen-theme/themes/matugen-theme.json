{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#19120c",
    "editor.foreground": "#efe0d5",
    "activityBar.background": "#211a14",
    "sideBar.background": "#261e18",
    "sideBar.border": "#51453a",
    "titleBar.activeBackground": "#19120c",
    "statusBar.background": "#261e18",
    "statusBar.foreground": "#efe0d5",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#fdb975",
    "activityBar.foreground": "#fdb975",
    "textLink.foreground": "#fdb975",
    "button.background": "#fdb975",
    "button.foreground": "#4a2800",
    "inputOption.activeBorder": "#fdb975",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#fdb97540",
    "list.hoverBackground": "#efe0d510",
    "list.activeSelectionForeground": "#fdb975",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#19120c",
    "tab.activeBackground": "#302822",
    "tab.inactiveBackground": "#19120c",
    "tab.activeBorderTop": "#fdb975"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#d5c3b5" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#efe0d5" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#c0cc9a" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#fdb975" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#e1c1a4" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#c0cc9a" }
    }
  ]
}
