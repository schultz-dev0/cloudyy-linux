{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#111318",
    "editor.foreground": "#e2e2e9",
    "activityBar.background": "#1a1b20",
    "sideBar.background": "#1e1f25",
    "sideBar.border": "#44474f",
    "titleBar.activeBackground": "#111318",
    "statusBar.background": "#1e1f25",
    "statusBar.foreground": "#e2e2e9",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#adc6ff",
    "activityBar.foreground": "#adc6ff",
    "textLink.foreground": "#adc6ff",
    "button.background": "#adc6ff",
    "button.foreground": "#102f60",
    "inputOption.activeBorder": "#adc6ff",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#adc6ff40",
    "list.hoverBackground": "#e2e2e910",
    "list.activeSelectionForeground": "#adc6ff",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#111318",
    "tab.activeBackground": "#282a2f",
    "tab.inactiveBackground": "#111318",
    "tab.activeBorderTop": "#adc6ff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c4c6d0" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e2e2e9" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#debcdf" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#adc6ff" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#bfc6dc" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#debcdf" }
    }
  ]
}
