{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#111418",
    "editor.foreground": "#e1e2e8",
    "activityBar.background": "#191c20",
    "sideBar.background": "#1d2024",
    "sideBar.border": "#43474e",
    "titleBar.activeBackground": "#111418",
    "statusBar.background": "#1d2024",
    "statusBar.foreground": "#e1e2e8",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#a1c9fd",
    "activityBar.foreground": "#a1c9fd",
    "textLink.foreground": "#a1c9fd",
    "button.background": "#a1c9fd",
    "button.foreground": "#00325a",
    "inputOption.activeBorder": "#a1c9fd",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#a1c9fd40",
    "list.hoverBackground": "#e1e2e810",
    "list.activeSelectionForeground": "#a1c9fd",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#111418",
    "tab.activeBackground": "#272a2f",
    "tab.inactiveBackground": "#111418",
    "tab.activeBorderTop": "#a1c9fd"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c3c6cf" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e1e2e8" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#d7bde4" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a1c9fd" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#bbc7db" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#d7bde4" }
    }
  ]
}
