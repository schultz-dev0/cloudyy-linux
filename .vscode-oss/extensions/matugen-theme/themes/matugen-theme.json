{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#101418",
    "editor.foreground": "#e0e2e8",
    "activityBar.background": "#181c20",
    "sideBar.background": "#1c2024",
    "sideBar.border": "#42474e",
    "titleBar.activeBackground": "#101418",
    "statusBar.background": "#1c2024",
    "statusBar.foreground": "#e0e2e8",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#98ccf9",
    "activityBar.foreground": "#98ccf9",
    "textLink.foreground": "#98ccf9",
    "button.background": "#98ccf9",
    "button.foreground": "#003351",
    "inputOption.activeBorder": "#98ccf9",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#98ccf940",
    "list.hoverBackground": "#e0e2e810",
    "list.activeSelectionForeground": "#98ccf9",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#101418",
    "tab.activeBackground": "#272a2e",
    "tab.inactiveBackground": "#101418",
    "tab.activeBorderTop": "#98ccf9"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c2c7ce" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e0e2e8" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#d1bfe7" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#98ccf9" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#b8c8da" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#d1bfe7" }
    }
  ]
}
