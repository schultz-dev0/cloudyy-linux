{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#121318",
    "editor.foreground": "#e2e2e9",
    "activityBar.background": "#1a1b20",
    "sideBar.background": "#1e1f25",
    "sideBar.border": "#44464f",
    "titleBar.activeBackground": "#121318",
    "statusBar.background": "#1e1f25",
    "statusBar.foreground": "#e2e2e9",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#b0c6ff",
    "activityBar.foreground": "#b0c6ff",
    "textLink.foreground": "#b0c6ff",
    "button.background": "#b0c6ff",
    "button.foreground": "#162e60",
    "inputOption.activeBorder": "#b0c6ff",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#b0c6ff40",
    "list.hoverBackground": "#e2e2e910",
    "list.activeSelectionForeground": "#b0c6ff",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#121318",
    "tab.activeBackground": "#282a2f",
    "tab.inactiveBackground": "#121318",
    "tab.activeBorderTop": "#b0c6ff"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#c5c6d0" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#e2e2e9" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#e0bbdd" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#b0c6ff" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#c0c6dc" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#e0bbdd" }
    }
  ]
}
