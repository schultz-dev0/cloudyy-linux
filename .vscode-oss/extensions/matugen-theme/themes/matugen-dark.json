{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    /* --- BASE UI --- */
    "editor.background": "#0e1416",
    "editor.foreground": "#dee3e5",
    "activityBar.background": "#171d1e",
    "sideBar.background": "#1b2122",
    "sideBar.border": "#3f484b",
    "titleBar.activeBackground": "#0e1416",
    "statusBar.background": "#1b2122",
    "statusBar.foreground": "#dee3e5",
    
    /* --- ACCENTS --- */
    "activityBar.activeBorder": "#83d2e5",
    "activityBar.foreground": "#83d2e5",
    "textLink.foreground": "#83d2e5",
    "button.background": "#83d2e5",
    "button.foreground": "#00363f",
    "inputOption.activeBorder": "#83d2e5",
    
    /* --- LISTS & TREES --- */
    "list.activeSelectionBackground": "#83d2e540",
    "list.hoverBackground": "#dee3e510",
    "list.activeSelectionForeground": "#83d2e5",
    
    /* --- TABS --- */
    "editorGroupHeader.tabsBackground": "#0e1416",
    "tab.activeBackground": "#252b2d",
    "tab.inactiveBackground": "#0e1416",
    "tab.activeBorderTop": "#83d2e5"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#bfc8cb" }
    },
    {
      "scope": ["variable", "string.constant.other.placeholder"],
      "settings": { "foreground": "#dee3e5" }
    },
    {
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#bdc5eb" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffb4ab" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#83d2e5" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#b2cbd2" }
    },
    {
      "scope": ["string"],
      "settings": { "foreground": "#bdc5eb" }
    }
  ]
}
