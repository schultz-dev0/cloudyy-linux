#!/usr/bin/env bash
# cloudyy:summary=Restart the SwayNC notification daemon
# swaync restart script

set -euo pipefail

readonly BIN="swaync"
readonly GRACE_STEPS=30
readonly GRACE_SLEEP=0.1
readonly SETTLE=0.3

_pids() {
	pgrep -x "$BIN" 2>/dev/null || true
}

_all_exited() {
	local pid
	for pid in "$@"; do
		if kill -0 "$pid" 2>/dev/null; then
			return 1
		fi
	done
	return 0
}

# Stop existing instances gracefully.
mapfile -t old_pids < <(_pids)
if ((${#old_pids[@]} > 0)); then
	kill -TERM "${old_pids[@]}" 2>/dev/null || true

	for ((i = 0; i < GRACE_STEPS; i++)); do
		_all_exited "${old_pids[@]}" && break
		sleep "$GRACE_SLEEP"
	done

	if ! _all_exited "${old_pids[@]}"; then
		kill -KILL "${old_pids[@]}" 2>/dev/null || true
		sleep 0.1
	fi
fi

# Start swaync in the proper user sessionw scope when possible.
if command -v uwsm-app >/dev/null 2>&1; then
	uwsm-app -- "$BIN" >/dev/null 2>&1 &
else
	setsid "$BIN" >/dev/null 2>&1 &
fi
disown 2>/dev/null || true

# Verify restart.
sleep "$SETTLE"
if [[ -n "$(_pids)" ]]; then
	echo "Ok"
else
	echo "failed to start" >&2
	exit 1
fi
