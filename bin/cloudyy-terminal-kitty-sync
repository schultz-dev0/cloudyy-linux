#!/usr/bin/env bash
# cloudyy:summary=Sync kitty terminal state
# cloudyy:hidden=true

# File to store persistent kitty states
STATE_DIR="${HOME}/.config/cloud-center/settings/terminal"
OPACITY_FILE="${STATE_DIR}/opacity"
CURSOR_FILE="${STATE_DIR}/cursor_shape"

# 1. Apply Opacity
if [[ -f "$OPACITY_FILE" ]]; then
    VAL=$(cat "$OPACITY_FILE")
    # Apply to all running kitty instances
    kitty @ set-background-opacity "$VAL" 2>/dev/null || true
fi

# 2. Apply Cursor
if [[ -f "$CURSOR_FILE" ]]; then
    SHAPE=$(cat "$CURSOR_FILE")
    kitty @ set-cursor-shape "$SHAPE" 2>/dev/null || true
fi
