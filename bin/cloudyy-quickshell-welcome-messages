#!/usr/bin/env bash
# cloudyy:summary=Manage welcome-message content shown in Spotlight
# cloudyy:hidden=true
# Command Center → Learn → Lock Screen Messages
set -euo pipefail

PERSONAL_MSG="${HOME}/.config/hypr/welcome_message.txt"
USER_MSG="${HOME}/.config/hypr/USER_WELCOME_MESSAGE.txt"
DEFAULT_MSG="${HOME}/cloudyy-linux/install/default-theme/USER_WELCOME_MESSAGE.txt"

if [[ -f "$PERSONAL_MSG" ]]; then
  FILE="$PERSONAL_MSG"
elif [[ -f "$USER_MSG" ]]; then
  FILE="$USER_MSG"
else
  FILE="$USER_MSG"
  mkdir -p "$(dirname "$FILE")"
  if [[ -f "$DEFAULT_MSG" ]]; then
    cp "$DEFAULT_MSG" "$FILE"
  else
    cat >"$FILE" <<'EOF'
# Add your custom messages here, one per line. These appear randomly on hyprlock.
# Format: prefix each message with > and wrap the text in quotes.

>"Did you know you can add custom messages here? Command Center → Learn → Lock Screen Messages"
EOF
  fi
fi

if command -v kitty >/dev/null 2>&1; then
  exec kitty --title "Lock Screen Messages" -e nvim "$FILE"
fi
exec nvim "$FILE"
