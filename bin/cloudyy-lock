#!/usr/bin/env bash
# cloudyy:summary=Lock the current session with the Cloudyy Quickshell lockscreen

set -euo pipefail

runtime_base="${XDG_RUNTIME_DIR:-/tmp/cloudyy-${UID}}"
runtime_dir="${runtime_base}/cloudyy-lock"
ready_file="${runtime_dir}/secure"
lock_config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/lock"
animation_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/animations.lua"

wait_for_unlock=false
case "${1:-}" in
  "") ;;
  --wait) wait_for_unlock=true ;;
  *)
    printf 'Usage: cloudyy-lock [--wait]\n' >&2
    exit 64
    ;;
esac

wait_until_secure() {
  for _ in $(seq 1 100); do
    [[ -e "$ready_file" ]] && return 0
    sleep 0.05
  done
  return 1
}

wait_until_unlocked() {
  while [[ -e "$ready_file" ]]; do
    sleep 0.1
  done
}

cursor_json="$(hyprctl cursorpos -j 2>/dev/null || printf '{}')"
prompt_output="$(hyprctl monitors -j 2>/dev/null | jq -r --argjson cursor "$cursor_json" '
  first(.[] | select(
    $cursor.x >= .x and $cursor.x < (.x + .width)
    and $cursor.y >= .y and $cursor.y < (.y + .height)
  ) | .name) // empty
' 2>/dev/null || true)"
if [[ -z "$prompt_output" ]]; then
  prompt_output="$(hyprctl monitors -j 2>/dev/null | jq -r 'first(.[] | select(.focused) | .name) // empty' 2>/dev/null || true)"
fi

# The lockscreen follows Cloud Center's workspace transition choice. The
# sentinel is the persisted source of truth for both the toggle and style.
workspace_animation="$(
  awk '/^-- @cloud-center-state = / { sub(/^-- @cloud-center-state = /, ""); print; exit }' "$animation_config" 2>/dev/null \
    | jq -r '.["animations:animation"] // ""' 2>/dev/null \
    | tr ';' '\n' \
    | awk -F, '$1 == "workspaces" && ($2 == "1" || $2 == "true") { print $5; exit }'
)"
case "$workspace_animation" in
  slidevert|slide|fade|slidefade|slidefadevert) ;;
  *) workspace_animation="none" ;;
esac

mkdir -p "$runtime_dir"
chmod 700 "$runtime_dir"

# A lockscreen instance remains alive until a successful unlock. A second
# request only waits for the first instance to acquire the Wayland session lock.
exec 9>"${runtime_dir}/launcher.lock"
if ! flock -n 9; then
  if wait_until_secure; then
    "$wait_for_unlock" && wait_until_unlocked
    exit 0
  fi
  printf 'cloudyy-lock: existing lockscreen did not become secure\n' >&2
  exit 1
fi

rm -f "$ready_file"
if ! CLOUDYY_LOCK_PROMPT_OUTPUT="$prompt_output" \
  CLOUDYY_LOCK_WORKSPACE_ANIMATION="$workspace_animation" \
  qs -n -d -p "$lock_config"; then
  if wait_until_secure; then
    "$wait_for_unlock" && wait_until_unlocked
    exit 0
  fi
  printf 'cloudyy-lock: could not start the lockscreen\n' >&2
  exit 1
fi

if wait_until_secure; then
  "$wait_for_unlock" && wait_until_unlocked
  exit 0
fi

printf 'cloudyy-lock: lockscreen did not become secure\n' >&2
exit 1
