#!/usr/bin/env bash
# cloudyy:summary=Walk up the current directory in the file manager
# Open Thunar in the cwd of the focused terminal window.
# Bind to a Hyprland key for the reverse of cwd_walk.sh.

set -euo pipefail

# shellcheck source=../lib/cwd_walk_lib.sh
source "${HOME}/cloudyy-linux/lib/cwd_walk_lib.sh"

notify() {
  command -v notify-send &>/dev/null || return 0
  notify-send "Files" "$1"
}

main() {
  command -v hyprctl &>/dev/null || { notify "hyprctl not found"; exit 1; }
  command -v jq &>/dev/null || { notify "jq not found"; exit 1; }
  command -v thunar &>/dev/null || { notify "thunar not found"; exit 1; }

  local cwd
  if ! cwd=$(cwd_walk_resolve_focused); then
    cwd="$HOME"
  fi

  # Thunar opens a new window on the given dir even when already running.
  if command -v uwsm-app &>/dev/null; then
    exec uwsm-app -- thunar "$cwd"
  fi

  exec thunar "$cwd"
}

main "$@"
