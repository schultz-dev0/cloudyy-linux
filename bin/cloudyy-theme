#!/usr/bin/env bash
# cloudyy:summary=Activate curated Cloudyy themes and manage wallpapers
# cloudyy:args={list [--json]|current|get-mode|prepare <slug>|bootstrap <slug>|use <slug>|reconcile [--apply-theme-wallpaper]|recover-previous|next|random|set-image <path>|restore|tag <image> <dark|light>|untag <image> <dark|light>}

set -euo pipefail

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/cloudyy-theme/common.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/common.sh"
# shellcheck source=lib/cloudyy-theme/package.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/package.sh"
# shellcheck source=lib/cloudyy-theme/wallpaper.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/wallpaper.sh"
# shellcheck source=lib/cloudyy-theme/adapters.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/adapters.sh"
# shellcheck source=lib/cloudyy-theme/reload.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/reload.sh"
# shellcheck source=lib/cloudyy-theme/reconcile.sh
source "$SCRIPT_DIR/../lib/cloudyy-theme/reconcile.sh"

usage() {
  cat <<'EOF'
Usage: cloudyy-theme <command> [arguments]

  list [--json]    Print shipped theme slugs in lexical order, or full metadata as JSON
  current          Print the active theme slug
  get-mode         Print the active theme's declared mode
  prepare <slug>   Validate, privately stage, and atomically promote a shipped theme
  bootstrap <slug> Prepare a theme and seed wallpaper state without session contact
  use <slug>       Prepare and activate a theme, including its wallpaper 1
  reconcile [--apply-theme-wallpaper]
                   Reapply active-theme integration, preserving the saved wallpaper by default
  recover-previous Atomically recover the retained previous theme and reconcile it
  next | random    Apply another image from the transitional wallpaper pool
  set-image <path> Apply a specific wallpaper without changing theme colors
  restore          Restore the saved wallpaper without changing theme colors
  tag <image> <dark|light>
  untag <image> <dark|light>
EOF
}

require_no_arguments() {
  [[ "$#" -eq 0 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
}

with_theme_lock() {
  local lock_mode="$1" lock_path lock_directory
  if ! theme_runtime_lock_available && ! theme_state_layout_safe; then
    return 1
  fi
  lock_path="$(theme_lock_path)"
  lock_directory="$(dirname -- "$lock_path")"
  if ! mkdir -p -- "$lock_directory"; then
    theme_error 'could not set up theme command lock'
    return "$CLOUDYY_THEME_EXIT_STAGING"
  fi
  if [[ -L "$lock_path" || ( -e "$lock_path" && ! -f "$lock_path" ) ]]; then
    theme_error 'theme command lock is not a regular file'
    return "$CLOUDYY_THEME_EXIT_STAGING"
  fi
  if ! exec {theme_lock_fd}>"$lock_path"; then
    theme_error 'could not open theme command lock'
    return "$CLOUDYY_THEME_EXIT_STAGING"
  fi
  if ! flock "$lock_mode" "$theme_lock_fd"; then
    theme_error 'could not acquire theme command lock'
    return "$CLOUDYY_THEME_EXIT_STAGING"
  fi
}

with_prepare_lock() {
  if ! with_theme_lock -x; then
    theme_error 'could not set up theme command lock'
    return "$CLOUDYY_THEME_EXIT_STAGING"
  fi
  prepare_theme "$1"
}

with_bootstrap_lock() {
  with_theme_lock -x || return "$CLOUDYY_THEME_EXIT_STAGING"
  prepare_theme "$1" || return $?
  seed_theme_wallpaper || return "$CLOUDYY_THEME_EXIT_RECONCILE"
}

with_use_lock() {
  with_theme_lock -x || return "$CLOUDYY_THEME_EXIT_STAGING"
  prepare_theme "$1" || return $?
  reconcile_theme true
}

with_reconcile_lock() {
  with_theme_lock -x || return "$CLOUDYY_THEME_EXIT_STAGING"
  reconcile_theme "$1"
}

with_recovery_lock() {
  with_theme_lock -x || return "$CLOUDYY_THEME_EXIT_STAGING"
  recover_previous_theme
}

with_wallpaper_lock() {
  with_theme_lock -x || return "$CLOUDYY_THEME_EXIT_STAGING"
  "$@" || {
    local result=$?
    [[ "$result" -eq "$CLOUDYY_THEME_EXIT_ACTIVE_STATE" || "$result" -eq "$CLOUDYY_THEME_EXIT_USAGE" ]] && return "$result"
    return "$CLOUDYY_THEME_EXIT_RECONCILE"
  }
}

print_active_mode() {
  local stage
  stage="$(active_stage)" || return 1
  jq -r '.mode' "$stage/theme/theme.json"
}

with_read_lock() {
  with_theme_lock -s || return 1
  "$@"
}

command="${1:-}"
case "$command" in
list)
  shift
  if [[ "${1:-}" == '--json' ]]; then
    shift
    require_no_arguments "$@"
    list_themes_json "$(with_read_lock current_theme_slug 2>/dev/null || true)"
  else
    require_no_arguments "$@"
    list_themes
  fi
  ;;
current)
  shift
  require_no_arguments "$@"
  with_read_lock current_theme_slug || {
    theme_error 'active theme state is uninitialized or corrupt'
    exit "$CLOUDYY_THEME_EXIT_ACTIVE_STATE"
  }
  ;;
get-mode)
  shift
  require_no_arguments "$@"
  with_read_lock print_active_mode || {
    theme_error 'active theme state is uninitialized or corrupt'
    exit "$CLOUDYY_THEME_EXIT_ACTIVE_STATE"
  }
  ;;
prepare)
  shift
  [[ "$#" -eq 1 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_prepare_lock "$1"
  ;;
bootstrap)
  shift
  [[ "$#" -eq 1 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_bootstrap_lock "$1"
  ;;
use)
  shift
  [[ "$#" -eq 1 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_use_lock "$1"
  ;;
reconcile)
  shift
  apply_theme_wallpaper=false
  if [[ "$#" -eq 1 && "$1" == '--apply-theme-wallpaper' ]]; then
    apply_theme_wallpaper=true
    shift
  fi
  require_no_arguments "$@"
  with_reconcile_lock "$apply_theme_wallpaper"
  ;;
recover-previous)
  shift
  require_no_arguments "$@"
  with_recovery_lock
  ;;
next)
  shift
  require_no_arguments "$@"
  with_wallpaper_lock wallpaper_next
  ;;
random)
  shift
  require_no_arguments "$@"
  with_wallpaper_lock wallpaper_random
  ;;
set-image)
  shift
  [[ "$#" -eq 1 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_wallpaper_lock wallpaper_set_image "$1"
  ;;
restore)
  shift
  require_no_arguments "$@"
  with_wallpaper_lock wallpaper_restore
  ;;
tag)
  shift
  [[ "$#" -eq 2 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_wallpaper_lock wallpaper_tag "$1" "$2"
  ;;
untag)
  shift
  [[ "$#" -eq 2 ]] || {
    usage >&2
    exit "$CLOUDYY_THEME_EXIT_USAGE"
  }
  with_wallpaper_lock wallpaper_untag "$1" "$2"
  ;;
*)
  usage >&2
  exit "$CLOUDYY_THEME_EXIT_USAGE"
  ;;
esac
