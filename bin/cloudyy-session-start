#!/usr/bin/env bash
# cloudyy:summary=Start the desktop only after the boot lockscreen unlocks

set -euo pipefail

scripts_dir="${HOME}/cloudyy_scripts"

personal_services=false
case "${1:-}" in
"") ;;
--personal) personal_services=true ;;
*)
  printf 'Usage: cloudyy-session-start [--personal]\n' >&2
  exit 64
  ;;
esac

# Restore the saved wallpaper behind the lock without rerunning Matugen or
# reloading Hyprland during login.
cloudyy-wallpaper-restore &
wallpaper_pid=$!

cloudyy-lock --wait
wait "$wallpaper_pid" 2>/dev/null || true

systemctl --user start hypridle.service
if ! systemctl --user start hyprpolkitagent.service 2>/dev/null; then
  /usr/lib/hyprpolkitagent/hyprpolkitagent &
fi
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

cloudyy-quickshell-start
systemctl --user start cloudyy-unlocked.target

if [[ ! -f "${HOME}/.config/OOBE/.dont_show" ]]; then
  qs -n -d -p "${HOME}/.config/OOBE"
fi

if "$personal_services"; then
  syncthing &
  python3 "${scripts_dir}/trcc-headless.py" &
  mxactions &
fi
