#!/usr/bin/env bash
# cloudyy:summary=Start the desktop only after the boot lockscreen unlocks

set -euo pipefail

scripts_dir="${HOME}/cloudyy_scripts"

personal_services=false
case "${1:-}" in
"") ;;
--personal) personal_services=true ;;
*)
  printf 'Usage: cloudyy-session-start [--personal]\n' >&2
  exit 64
  ;;
esac

# TTY-launched sessions also need to pass their display and runtime paths to
# user services. Import only known session variables, never the whole environment.
session_vars=()
for name in WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP PATH GI_TYPELIB_PATH QML_IMPORT_PATH GSETTINGS_SCHEMA_DIR; do
  [[ -v "$name" ]] && session_vars+=("$name")
done
systemctl --user import-environment "${session_vars[@]}"

# Restore the saved wallpaper behind the lock without reloading applications.
cloudyy-wallpaper-restore &
wallpaper_pid=$!

cloudyy-lock --wait
wait "$wallpaper_pid" 2>/dev/null || true

systemctl --user start hypridle.service
if ! systemctl --user start hyprpolkitagent.service 2>/dev/null; then
  if command -v hyprpolkitagent >/dev/null 2>&1; then
    hyprpolkitagent &
  else
    /usr/lib/hyprpolkitagent/hyprpolkitagent &
  fi
fi
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

cloudyy-quickshell-start
if ! cloudyy-theme reconcile; then
  printf 'cloudyy-session-start: theme reconciliation failed\n' >&2
fi
systemctl --user start cloudyy-unlocked.target


if "$personal_services"; then
  syncthing &
  python3 "${scripts_dir}/trcc-headless.py" &
  mxactions &
fi
