#!/usr/bin/env bash
# Dispatcher for cloudyy-* commands. Bare `cloudyy` lists groups;
# `cloudyy <group> <action...>` execs cloudyy-<group>-<action...>.
set -euo pipefail

declare -A GROUP_DESCRIPTIONS=(
  [boot]="UEFI boot targets and boot-time optimizations"
  [center]="Cloud Center system settings app"
  [clipboard]="Clipboard copy/paste and OCR"
  [code]="Editor theme sync"
  [config]="Post-install configuration"
  [debug]="System diagnostics"
  [idle]="Idle scene and lockscreen"
  [kitty]="Kitty terminal helpers"
  [nvim]="Neovim theme integration"
  [quickshell]="Quickshell shell control"
  [screenshot]="Screenshots and screen capture"
  [slider]="Volume, brightness, and nightlight sliders"
  [swayosd]="On-screen display control"
  [terminal]="Terminal and file-manager helpers"
  [theme]="Curated themes and wallpapers"
  [update]="System and repo updates"
  [wlogout]="Logout/power menu"
)

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

list_commands() {
  local f name summary hidden
  declare -A by_group=()
  for f in "$bin_dir"/cloudyy-*; do
    [[ -f "$f" && -x "$f" ]] || continue
    name="$(basename "$f")"
    summary=""
    hidden=""
    while IFS= read -r line; do
      [[ $line == \#\ cloudyy:summary=* ]] && summary="${line#\# cloudyy:summary=}"
      [[ $line == \#\ cloudyy:hidden=true ]] && hidden=1
    done < <(head -n 80 "$f")
    [[ -n "$hidden" ]] && continue
    local group="${name#cloudyy-}"
    group="${group%%-*}"
    by_group["$group"]+="  ${name}  —  ${summary}"$'\n'
  done
  printf 'Usage: cloudyy <group> <action...>\n\n'
  local g
  for g in "${!by_group[@]}"; do
    printf '%s (%s)\n%s\n' "$g" "${GROUP_DESCRIPTIONS[$g]:-}" "${by_group[$g]}"
  done
}

if [[ $# -eq 0 ]]; then
  list_commands
  exit 0
fi

group="$1"
shift
if [[ $# -eq 0 ]]; then
  list_commands
  exit 0
fi
action="$1"
shift
target="${bin_dir}/cloudyy-${group}-${action}"
if [[ -x "$target" ]]; then
  exec "$target" "$@"
fi

# Commands that implement their own subcommand dispatch can omit group-action
# metadata and are passed through unchanged (for example, `cloudyy theme use nord`).
single_target="${bin_dir}/cloudyy-${group}"
if [[ -x "$single_target" ]]; then
  exec "$single_target" "$action" "$@"
fi

printf 'cloudyy: unknown command "%s %s" (no %s or %s)\n' \
  "$group" "$action" "$(basename "$target")" "$(basename "$single_target")" >&2
exit 1
